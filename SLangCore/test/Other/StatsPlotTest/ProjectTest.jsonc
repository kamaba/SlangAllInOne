{
  "project":
  {
    "name": "ProjectTest",
    "desc": "StatsPlotTest - SLang.StatsPlot module end-to-end test (stats values / DataFrame fromCsv+summary+filter+sort+groupBy+table / six chart canvases pixel asserts / ascii preview)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "StatsPlotTest.sl", "group": "default", "tag": "test", "ignore": false, "priority": 0 },
      { "path": "ProjectTest.sp", "group": "default", "tag": "test", "ignore": false, "priority": 1 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {}
  },
  "references": [
    // 官方库直查（宿主 bin\lib\ 回落）
    { "path": "./lib/Core.module.slb" },
    { "path": "./lib/Std.module.slb" },
    // StatsPlot 模块（out/export/StatsPlot：module.json + slb；运行期经 slb 引用 Math）
    { "path": "../../../../out/export/StatsPlot/StatsPlot.module.json" }
  ],
  "export": {
    "moduleName": "StatsPlotTest",
    "outputDir": "..\\..\\..\\..\\out\\export",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": false,
      "token": false,
      "node": false,
      "file": false,
      "meta": false,
      "ir": false
    }
  }
}