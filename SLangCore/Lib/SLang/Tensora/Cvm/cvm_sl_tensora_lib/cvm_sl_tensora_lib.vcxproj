  <!-- 合一工程：cvm 全硬件平台原生层（CPU SIMD / NVIDIA CUDA，后续 ROCm·TPU·NPU
       等平台在本工程内追加源文件），产出单一 sl_tensora_lib.dll 供 Tensora 的
       @DllStaticImport 静态绑定（slcp_* = CPU，slc_* = CUDA）。零外部依赖：
         CPU   —— 自身即实现；ISA 矩阵按文件划分编译目标：
                  sl_cpu_lib.c          —— 基线（SSE2 恒可用），cpuid/XGETBV 检测 + 分派；
                  slcp_kernels_sse2.c   —— 基线（SSE2，x64 默认，无 /arch 开关）；
                  slcp_kernels_avx2.c   —— /arch:AVX2（运行期检测启用）；
                  slcp_kernels_avx512.c —— /arch:AVX512（运行期检测启用）；
                  slcp_kernels_neon.c   —— ARM64 预留，x64 工程不编译。
         CUDA  —— CUDA 驱动 API（cuInit / cuMemAlloc / cuLaunchKernel ...）全部运行期
                  从 nvcuda.dll（随 NVIDIA 显卡驱动安装于 System32）LoadLibrary +
                  GetProcAddress 解析，构建期不需要 CUDA Toolkit（无 cuda.h / 无 .lib）。
       CPU 位级一致契约（Tier-1）：仅 IEEE 单舍入指令、禁 FMA intrinsic、
       MSVC 默认 /fp:precise（不设 FloatingPointModel=Fast）。 -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;_WINDOWS;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- ── CPU：入口 / 检测 / 分派 + ISA kernel 矩阵 ─────────────────── -->
    <ClCompile Include="sl_cpu_lib.c" />
    <ClCompile Include="slcp_kernels_sse2.c" />
    <!-- AVX2 kernel：整文件 /arch:AVX2（运行期检测后才可达）。 -->
    <ClCompile Include="slcp_kernels_avx2.c">
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
    <!-- AVX-512 kernel：整文件 /arch:AVX512（运行期检测后才可达）。 -->
    <ClCompile Include="slcp_kernels_avx512.c">
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions512</EnableEnhancedInstructionSet>
    </ClCompile>
    <!-- ── CUDA：NVIDIA 驱动 API 包装（slc_*，运行期解析 nvcuda.dll）── -->
    <ClCompile Include="sl_cuda_lib.c" />
    <!-- ── ONNX：手写 protobuf wire 解析器（slo_*，零外部依赖）──── -->
    <ClCompile Include="sl_onnx.c" />
    <!-- ── 跨平台内存辅助：主机侧 memcpy 原语（slm_*）────────────── -->
    <ClCompile Include="sl_mem.c" />
    <!-- slcp_kernels_neon.c 为 ARM64 预留，x64 不编译（见文件头注释）。 -->
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="vm_sl_cpu.h" />
    <ClInclude Include="vm_sl_cuda.h" />
    <ClInclude Include="vm_sl_onnx.h" />
    <ClInclude Include="vm_sl_mem.h" />
  </ItemGroup>
