{
  "project": {
    "name": "SLangWebUI",
    "desc": "WebUI GUI library module - namespace SLang.WebUI (browser-as-GUI, backed by webui_lib.dll / vendored webui.c, MIT)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "dllImports": [
    {
      "path": "webui_lib.dll",
      "name": "webui_lib",
      "alias": "webui_lib",
      "static": "webui_lib"
    }
  ],
  "vmDlls": [
    {
      "project": "cvm_webui_lib/cvm_webui_lib.vcxproj",
      "name": "webui_lib.dll",
      "configuration": "Debug",
      "platform": "x64"
    }
  ],
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      {
        "path": "WebUI.sl",
        "group": "webui",
        "tag": "gui",
        "ignore": false,
        "priority": 0
      }
    ]
  },
  "references": [
    {
      "path": "../../Core",
      "name": "Core"
    },
    {
      "path": "../../Std",
      "name": "Std"
    }
  ],
  "struct": [
    {
      "namespace": "SLang",
      "children": [
        {
          "class": "WebUI"
        },
        {
          "class": "WebUIWindow"
        }
      ]
    }
  ],
  "export": {
    "moduleName": "SLangWebUI",
    "outputDir": "export",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  },
  "global": {
    "imports": []
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  }
}
