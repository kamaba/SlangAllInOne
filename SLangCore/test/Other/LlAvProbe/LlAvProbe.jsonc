{
  "project":
  {
    "name": "LlAvProbe",
    "desc": "AV crash probe: isolate the exact crashing call in LinkedList addLast/addFirst sequence",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": []
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
  },
  "references": [
    { "path": "./lib/Core.module.slb" }
  ],
  "struct": [
      { "namespace": "LlAvProbe", "children": [] }
  ],
  "export": {
    "moduleName": "LlAvProbe",
    "outputDir": "..\\..\\..\\..\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": false,
      "token": false,
      "node": false,
      "file": false,
      "meta": false,
      "ir": false
    }
  }
}
