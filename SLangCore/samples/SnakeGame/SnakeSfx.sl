import SLangAudio;
import Std;
import Core;

# SnakeSfx - sound effects for SnakeGame (SLangAudio module, 2026-11-19).
# Unity-style one-shot playback: Audio.AudioSource.playOneShot + per-frame
# update() recycles finished one-shot players. Wav assets live in sfx\
# (generated by make-sfx.ps1); directory resolved by probing candidates
# (SceneDemo findSceneDir pattern). All audio failures degrade gracefully:
# game runs silent, lastError records why.
#
# Cross-module form rules (doc/10 §6): static calls across modules are only
# reliable with no-arg / string params (Audio.AudioClip.loadFile(string),
# Audio.AudioIO.deviceAvailable()); everything else (constructor, property
# setter, playOneShot) goes through instance methods.
public class SnakeSfx
{
    static Audio.AudioSource src = null
    static Audio.AudioClip clipEat = null
    static Audio.AudioClip clipDie = null
    static Audio.AudioClip clipStart = null
    static Audio.AudioClip clipMove = null
    # BGM 主通道（独立音源，loop 循环；与 one-shot 音效互不打断）
    static Audio.AudioClip clipBgm = null
    static Audio.AudioSource bgmSrc = null
    # 声音/背景乐开关（FairyGUI checkbox 消费）
    static bool ok = false
    static bool sfxOn = true
    static bool bgmOn = true
    static string lastError = ""
    static string sfxDirStr = ""

    static string findSfxDir()
    {
        string cwd = IO.Directory.getCurrentDirectory()
        string p1 = cwd + "/sfx"
        bool e1 = File.exists( p1 + "/eat.wav" )
        if e1
        {
            ret p1
        }
        string p2 = cwd + "/SLangCore/Lib/SLang/SimGameEngine/gameExample/SnakeGame/sfx"
        bool e2 = File.exists( p2 + "/eat.wav" )
        if e2
        {
            ret p2
        }
        # 源码树绝对路径兜底（SceneDemo findSceneDir 同款；CWD 在
        # d:\project\lang 等上层目录时上面两个候选都会落空 → 之前
        # 「声音没出来」的根因即此：sfx 目录找不到 → init 失败 → 全静音）
        string p3 = "D:/project/lang/SlangAllInOne/SLangCore/Lib/SLang/SimGameEngine/gameExample/SnakeGame/sfx"
        bool e3 = File.exists( p3 + "/eat.wav" )
        if e3
        {
            ret p3
        }
        # wasm/MEMFS 候选（web 版 game.js 经 FS.writeFile stage；桌面探测
        # 恒落空，不影响既有路径）
        string p4 = "/work/snake/sfx"
        bool e4 = File.exists( p4 + "/eat.wav" )
        if e4
        {
            ret p4
        }
        string p5 = "/sfx"
        bool e5 = File.exists( p5 + "/eat.wav" )
        if e5
        {
            ret p5
        }
        ret ""
    }

    static Audio.AudioClip tryLoad( string dir, string name )
    {
        string p = dir + "/" + name
        Audio.AudioClip c = Audio.AudioClip.loadFile( p )
        if c == null
        {
            lastError = name + ": " + Audio.AudioIO.lastErrorText()
        }
        ret c
    }

    public static bool init()
    {
        if ok
        {
            ret true
        }
        bool dev = Audio.AudioIO.deviceAvailable()
        if !dev
        {
            lastError = "no audio device"
            ret false
        }
        string dir = findSfxDir()
        if dir == ""
        {
            lastError = "sfx dir not found"
            ret false
        }
        Audio.AudioClip c1 = tryLoad( dir, "eat.wav" )
        Audio.AudioClip c2 = tryLoad( dir, "die.wav" )
        Audio.AudioClip c3 = tryLoad( dir, "start.wav" )
        Audio.AudioClip c4 = tryLoad( dir, "move.wav" )
        if c1 == null
        {
            ret false
        }
        if c2 == null
        {
            ret false
        }
        if c3 == null
        {
            ret false
        }
        if c4 == null
        {
            ret false
        }
        Audio.AudioSource s = Audio.AudioSource()
        s.volume = 0.7f
        src = s
        clipEat = c1
        clipDie = c2
        clipStart = c3
        clipMove = c4
        sfxDirStr = dir
        ok = true
        # bgm 可选：缺文件只降级背景乐，不影响音效
        string bp = dir + "/bgm.wav"
        bool be = File.exists( bp )
        if be
        {
            Audio.AudioClip c5 = tryLoad( dir, "bgm.wav" )
            if c5 != null
            {
                clipBgm = c5
            }
        }
        Console.println( "[sfx] ready (4 clips from " + dir + ")" )
        ret true
    }

    # ── 开关与 BGM ──────────────────────────────────────────────

    public static void setSfxEnabled( bool on )
    {
        sfxOn = on
    }

    public static void setBgmEnabled( bool on )
    {
        bgmOn = on
        if !on
        {
            stopBgm()
            ret
        }
        if !ok
        {
            ret
        }
        if clipBgm == null
        {
            ret
        }
        if bgmSrc == null
        {
            Audio.AudioSource b = Audio.AudioSource()
            b.volume = 0.4f
            b.loop = true
            b.clip = clipBgm
            bgmSrc = b
        }
        bgmSrc.Play()
    }

    public static bool stopBgm()
    {
        if bgmSrc == null
        {
            ret true
        }
        ret bgmSrc.Stop()
    }

    # 排行榜/数据文件目录（与 sfx 同目录；发布态在 publish\release\sfx）
    public static string dataDir()
    {
        ret sfxDirStr
    }

    # per-frame one-shot recycling + bgm loop re-enqueue
    public static void update()
    {
        if ok
        {
            src.update()
        }
        if bgmSrc != null
        {
            if bgmOn
            {
                bgmSrc.update()
            }
        }
    }

    public static void eat()
    {
        if !ok
        {
            ret
        }
        if !sfxOn
        {
            ret
        }
        src.playOneShot( clipEat, 1.0f )
    }

    public static void die()
    {
        if !ok
        {
            ret
        }
        if !sfxOn
        {
            ret
        }
        src.playOneShot( clipDie, 1.0f )
    }

    public static void startJingle()
    {
        if !ok
        {
            ret
        }
        if !sfxOn
        {
            ret
        }
        src.playOneShot( clipStart, 1.0f )
    }

    # 每步 tick：专用常驻音源（Play() 停旧入新即重播）。此前走 playOneShot
    # = 每步新建一个 waveOut 设备，短音被设备延迟吞掉听不见——常驻音源修法
    static Audio.AudioSource tickSrc = null

    public static void move()
    {
        if !ok
        {
            ret
        }
        if !sfxOn
        {
            ret
        }
        if tickSrc == null
        {
            Audio.AudioSource t = Audio.AudioSource()
            t.volume = 0.45f
            t.clip = clipMove
            tickSrc = t
        }
        tickSrc.Play()
    }

    public static string statusText()
    {
        if ok
        {
            ret "sfx=on"
        }
        ret "sfx=off(" + lastError + ")"
    }
}
