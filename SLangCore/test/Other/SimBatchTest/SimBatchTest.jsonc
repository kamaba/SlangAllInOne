{
  "project": {
    "name": "SimBatchTest",
    "desc": "SimGameEngine P2 batching smoke - visible collection (active/layer mask/visibility) + stable sort + group merging (shared material merge, different material/queue/layer/color split, 256 cap, single-object path) + vertex baking (worldMatrix x local) + clear reuse",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "SimBatchTest.sl", "group": "scene", "tag": "base", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "references": [
    // 消费方引用导出模块包（路径引用源码 jsonc 只注册类型名、不带成员元数据）
    { "path": "../../../../out/export/SimGameEngine/SimGameEngine.module.slb", "name": "SimGameEngine" },
    // List/Array/Int32.toString 等 Core 成员需显式引用（不可 import Core，只引用）
    { "path": "../../../Lib/Core", "name": "Core" },
    { "path": "../../../Lib/Std", "name": "Std" },
    { "path": "../../../Lib/Math", "name": "Math" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "SimBatchTest",
    "outputDir": "export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true
  }
}
