{
  "project":
  {
    "name": "RefProbe",
    "desc": "Official-library direct-lookup probe: references use bare module names (Core/Std) resolved from the slang runtime lib dir (lib\\, see md/project/package-layout.md)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": false,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "RefProbe.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ]
  },
  "references": [
    { "path": "Core", "name": "Core.module.json" },
    { "path": "Std", "name": "Std.module.json" }
  ],
  "export": {
    "moduleName": "RefProbe",
    "outputDir": ".",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": false,
      "token": false,
      "node": false,
      "file": false,
      "meta": false,
      "ir": false
    }
  }
}
