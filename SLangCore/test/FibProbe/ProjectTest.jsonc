{
  "project":
  {
    "name": "FibProbe",
    "desc": "Fibonacci micro-benchmark probe (D2 fusion measurement)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": true,
    "target": "x64",
    "debug": false,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "Fibonacci.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std"
    ]
  },
  "references": [
    { "path": "./lib/Core.module.slb" },
    { "path": "./lib/Std.module.slb" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "FibProbe",
    "outputDir": "..\\..\\..\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true
  }
}
