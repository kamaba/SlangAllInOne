{
  "project":
  {
    "name": "ProjectTest",
    "desc": "ImageQtTest - SLangImage x SLangQT display bridge (gallery via Image APIs -> ImageBuffer.toNativeRgba -> QLabel.setPixmapRgba)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "ImageQtTest.sl", "group": "default", "tag": "test", "ignore": false, "priority": 0 },
      { "path": "ProjectTest.sp", "group": "default", "tag": "test", "ignore": false, "priority": 1 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {}
  },
  "references": [
    { "path": "./lib/Core.module.slb" },
    { "path": "./lib/Std.module.slb" },
    // SLangQT 引用形态（QTTest 2026-11-03 修复同款）：文件形态直引产物，
    // 带 "name" 声明。目录形态会让 Front 以 ref 导入空壳副本遮蔽真实模块
    // （@DllStaticImport 丢失 -> FFI 全失效），勿改回目录形态。
    { "path": "./modules/SLangQT/SLangQT.module.slb", "name": "SLangQT" },
    // SLangImage 模块（out/export/SLangImage：module.json + slb + sl_image_lib.dll）
    { "path": "../../../../out/export/SLangImage/SLangImage.module.json" }
  ],
  "export": {
    "moduleName": "ImageQtTest",
    "outputDir": "..\\..\\..\\..\\out\\export",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true
  }
}
