{
  "project":
  {
    "name": "Tensora",
    "desc": "Tensora library - AI common classes: tensor/shape/ops, autograd, activations, losses, layers (dense/conv/pool/norm/dropout), module, rnn/lstm/gru, embedding, attention/transformer, optimizers, lr schedulers, metrics, dataset, tokenizer, trainer",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "systemCalls":
  [
    // 全部能力由 SL 层实现，仅需 Core 的系统调用（SystemPrintln / SystemConvert* / SystemArray*）
    // cvm 原生算子经 Cvm.sl @DllStaticImport 静态绑定直调（不下沉 SystemMethodCall）
  ],
  // ── cvm：统一硬件算子计算平台（P2B，Tensora\Cvm\）─────────────────
  // FFI 导入表（jsonc "dllImports" 段）：cvm 加载 Tensora 模块即预载
  // sl_tensora_lib.dll 并注册进 FFI.StaticLibrary，
  // @DllStaticImport ("sl_tensora_lib","slcp_*"/"slc_*") 静态调用点由 cvm 装配期 attribute 注册表
  // 改写为 CallFFIStatic(77) 直调绑定表。绑定失败（库未注册 / 符号
  // 缺失）时回退 SL 函数体兜底（返回 0/false/null，Cvm.libIsaId()
  // 返回 -1 即兜底征兆）。
  "dllImports":
  [
    { "path": "sl_tensora_lib.dll", "name": "sl_tensora_lib", "alias": "sl_tensora_lib", "static": "sl_tensora_lib" }
  ],
  // vmDlls 构建规则：导出 Tensora 模块时，Front 用 MSBuild 编译
  // project 指向的 VS 工程（路径相对本 jsonc 所在目录），并把产出的
  // sl_tensora_lib.dll 拷贝到与 Tensora.module.json 相同的目录
  // （out/export/Tensora/），即上方 dllImports 别名指向的位置。
  // C 实现位于 Tensora\Cvm\cvm_sl_tensora_lib\cvm_sl_tensora_lib.vcxproj
  // （cvm 合一工程：CPU / CUDA / 后续 ROCm·TPU·NPU 平台的源文件都在这一
  // 工程内，产出单一 sl_tensora_lib.dll）：
  //   sl_cpu_lib.c          CPU 入口 / cpuid+XCR0 检测 / 函数指针表分派
  //   slcp_kernels_sse2.c   SSE2 保底 kernel（x64 基线，无 /arch 开关）
  //   slcp_kernels_avx2.c   AVX2 kernel（per-file /arch:AVX2）
  //   slcp_kernels_avx512.c AVX-512F/VL/DQ kernel（per-file /arch:AVX512）
  //   slcp_kernels_neon.c   NEON kernel（ARM64 预留，x64 工程不编译）
  //   sl_cuda_lib.c         NVIDIA GPU：CUDA 驱动 API（slc_*）运行期解析
  //   vm_sl_cuda.h          nvcuda.dll，零 Toolkit 依赖；SL 绑定在 Cvm\Cuda.sl
  // 零外部依赖；CPU Tier-1 kernel 与 Tensora L0 位级一致（仅 IEEE 单舍入
  // 指令、禁 FMA，TensoraBackend.md §6.1.4）。后续 ROCm/TPU/NPU 等平台
  // 在该工程内追加源文件即可。
  "vmDlls": [
    { "project": "Cvm/cvm_sl_tensora_lib/cvm_sl_tensora_lib.vcxproj", "name": "sl_tensora_lib.dll", "configuration": "Debug", "platform": "x64" }
  ],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      // ── 基础：形状 / 类型 / 数学 / 随机 / 设备 / 后端注册 / 张量 ──
      // 顺序即依赖顺序：Tensor 依赖 TensorMath(Math.sl)、Rng(Random.sl)、
      // Device、EDtype、BackendError（to() 的 throws 通道）
      { "path": "Shape.sl",   "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Dtype.sl",   "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Math.sl",    "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Random.sl",  "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Device.sl",  "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Cvm/Cpu_x64.sl", "group": "tensora", "tag": "cvm", "ignore": false, "priority": 0 },
      { "path": "Cvm/Cpu_arm64.sl", "group": "tensora", "tag": "cvm", "ignore": false, "priority": 0 },
      { "path": "Cvm/Tpu.sl", "group": "tensora", "tag": "cvm", "ignore": false, "priority": 0 },
      { "path": "Cvm/Npu.sl", "group": "tensora", "tag": "cvm", "ignore": false, "priority": 0 },
      { "path": "Cvm/Onnx.sl", "group": "tensora", "tag": "cvm", "ignore": false, "priority": 0 },
      { "path": "Cvm/Mem.sl", "group": "tensora", "tag": "cvm", "ignore": false, "priority": 0 },
      { "path": "Cvm/Cvm.sl", "group": "tensora", "tag": "cvm", "ignore": false, "priority": 0 },
      { "path": "Cvm/Cuda.sl", "group": "tensora", "tag": "cvm", "ignore": false, "priority": 0 },
      { "path": "Backends/BackendRegistry.sl", "group": "tensora", "tag": "core", "ignore": false, "priority": 0 },
      { "path": "Backends/CudaBackend.sl", "group": "tensora", "tag": "core", "ignore": false, "priority": 0 },
      { "path": "Tensor.sl",  "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Init.sl",    "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Ops.sl",     "group": "tensora", "tag": "ops",   "ignore": false, "priority": 0 },

      // ── 自动微分 / 激活 / 损失 ─────────────────────────
      { "path": "Autograd.sl",   "group": "tensora", "tag": "autograd", "ignore": false, "priority": 0 },
      { "path": "Activation.sl", "group": "tensora", "tag": "nn",       "ignore": false, "priority": 0 },
      { "path": "Loss.sl",       "group": "tensora", "tag": "nn",       "ignore": false, "priority": 0 },

      // ── 网络层 ─────────────────────────────────────────
      { "path": "Layer.sl",         "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Dense.sl",         "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Conv.sl",          "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Pooling.sl",       "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Normalization.sl", "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Dropout.sl",       "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Flatten.sl",       "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Module.sl",        "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Embedding.sl",     "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Recurrent.sl",     "group": "tensora", "tag": "rnn",  "ignore": false, "priority": 0 },

      // ── Transformer ───────────────────────────────────
      { "path": "Attention.sl",   "group": "tensora", "tag": "attn", "ignore": false, "priority": 0 },
      { "path": "Transformer.sl", "group": "tensora", "tag": "attn", "ignore": false, "priority": 0 },
      { "path": "TransformerModel.sl", "group": "tensora", "tag": "attn", "ignore": false, "priority": 0 },

      // ── 训练：优化器 / 调度 / 指标 / 数据 / 分词 / 训练器 ──
      { "path": "Optimizer.sl", "group": "tensora", "tag": "train", "ignore": false, "priority": 0 },
      { "path": "Scheduler.sl", "group": "tensora", "tag": "train", "ignore": false, "priority": 0 },
      { "path": "Metrics.sl",   "group": "tensora", "tag": "train", "ignore": false, "priority": 0 },
      { "path": "Dataset.sl",   "group": "tensora", "tag": "data",  "ignore": false, "priority": 0 },
      { "path": "Tokenizer.sl", "group": "tensora", "tag": "data",  "ignore": false, "priority": 0 },
      { "path": "Trainer.sl",   "group": "tensora", "tag": "train", "ignore": false, "priority": 0 },

      // ── 异步计算：协程任务 / Isolate 协调 / Future ──
      { "path": "Async.sl",     "group": "tensora", "tag": "async", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {
      "DEBUG": "true"
    },
    "data": {
      "defaultBatchSize": 32,
      "defaultLearningRate": 0.001,
      // P2B（§6.1.3-1）：CPU L1 SIMD 总开关默认值，默认关闭；true 时
      // Backends.simd*On 阈值表生效，大矩阵走 sl_tensora_lib.dll 原生
      // kernel（Tier-1 位级一致）。声明性文档：Tensora 为库工程（无
      // .sp / Project 类），jsonc data.* 注入通道不生效，SL 侧为硬
      // 默认 false，运行期用 Backends.setSimdEnabled() 覆盖。
      "tensoraSimdEnabled": false,
      "tensoraCudaEnabled": false
    }
  },
  "references": [
    { "path": "../Core", "name": "Core" },
    { "path": "../Std", "name": "Std" },
    { "path": "../Math", "name": "Math" }
  ],
  // 注意：新增类必须追加在 children 末尾（Backends 之后）——插在中间会使
  // 既有类槽位后移，实测触发 C VM vm_sys_array_set_value_this 访问违例
  // （TransformerModelTest 训练循环崩，dump: slang.exe.19804.dmp）。
  "struct": [
    { "namespace": "Tensora", "children": [
      { "class": "Shape" },
      { "class": "EDtype" },
      { "class": "Dtype" },
      { "class": "Tensor" },
      { "class": "TensorMath" },
      { "class": "Rng" },
      { "class": "Init" },
      { "class": "Ops" },
      { "class": "Variable" },
      { "class": "Graph" },
      { "class": "EActivation" },
      { "class": "Activation" },
      { "class": "Loss" },
      { "class": "Layer" },
      { "class": "Dense" },
      { "class": "Conv2D" },
      { "class": "MaxPool2D" },
      { "class": "AvgPool2D" },
      { "class": "BatchNorm" },
      { "class": "LayerNorm" },
      { "class": "Dropout" },
      { "class": "Flatten" },
      { "class": "Module" },
      { "class": "Sequential" },
      { "class": "Embedding" },
      { "class": "RNNCell" },
      { "class": "LSTMCell" },
      { "class": "GRUCell" },
      { "class": "RNN" },
      { "class": "Attention" },
      { "class": "MultiHeadAttention" },
      { "class": "PositionalEncoding" },
      { "class": "TransformerBlock" },
      { "class": "Transformer" },
      { "class": "SeqPool" },
      { "class": "TransformerClassifier" },
      { "class": "Optimizer" },
      { "class": "SGD" },
      { "class": "Adam" },
      { "class": "AdamW" },
      { "class": "RMSProp" },
      { "class": "Adagrad" },
      { "class": "LRScheduler" },
      { "class": "StepLR" },
      { "class": "ExponentialLR" },
      { "class": "CosineLR" },
      { "class": "WarmupLR" },
      { "class": "ReduceLROnPlateau" },
      { "class": "Metrics" },
      { "class": "Batch" },
      { "class": "Dataset" },
      { "class": "DataLoader" },
      { "class": "Normalizer" },
      { "class": "Vocab" },
      { "class": "Tokenizer" },
      { "class": "History" },
      { "class": "Trainer" },
      { "class": "EDeviceKind" },
      { "class": "Device" },
      { "class": "BackendError" },
      { "class": "Cvm" },
      { "class": "Backends" },
      { "class": "Cuda" },
      { "class": "CudaDevice" },
      { "class": "CudaBuffer" },
      { "class": "CudaStream" },
      { "class": "CudaEvent" },
      { "class": "CudaKernel" },
      { "class": "CudaKernelArgs" },
      { "class": "CudaBackend" },
      { "class": "Cpu_x64" },
      { "class": "Cpu_arm64" },
      { "class": "Tpu" },
      { "class": "Npu" },
      { "class": "Onnx" },
      { "class": "Mem" },
      // ── 异步计算（必须追加在末尾：插中间会使既有类槽位后移致 C VM 越界） ──
      { "class": "AsyncStatus" },
      { "class": "EComputeMode" },
      { "class": "EAsyncOp" },
      { "class": "TensorJob" },
      { "class": "TensorAsync" }
    ]}
  ],
  "export": {
    "moduleName": "Tensora",
    "outputDir": "..\\..\\..\\..\\out\\export",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true,
    // Front 调试文本实际目录：{export.outputDir}/{export.moduleName}/DebugCode/
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
