{
  // RDataGallery —— Std.RData 数据结构 + GameEngine 映射 chats + RenderTexture 回绘 QT
  // 构建：slang compile RDataGallery.jsonc --format binary+json
  // 发布：slang publish RDataGallery.sp --mode both --cvm Release
  "project": {
    "name": "RDataGallery",
    "desc": "QT gallery for Std.RData structures mapped by SimGameEngine.RDataChart, with DrawCanvas -> RenderTexture -> QLabel blit",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": { "root": "." },
  // 模块引用不透传 dllImports：消费方需自行声明渲染库，才能拿到 RenderTexture
  "dllImports": [
    { "path": "sl_render_lib.dll", "name": "sl_render_lib", "alias": "sl_render_lib", "static": "sl_render_lib" }
  ],
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "RDataHost.sl", "group": "game", "tag": "game", "ignore": false, "priority": 0 },
      { "path": "RDataGallery.sl", "group": "game", "tag": "game", "ignore": false, "priority": 1 }
    ]
  },
  "references": [
    { "path": "../../../../../SLangCore/Lib/Core", "name": "Core" },
    { "path": "../../../../../SLangCore/Lib/Std", "name": "Std" },
    { "path": "../../../../../SLangCore/Lib/Math", "name": "Math" },
    { "path": "D:/project/lang/SlangAllInOne/out/export/SimGameEngine/SimGameEngine.module.slb", "name": "SimGameEngine" },
    { "path": "D:/project/lang/SlangAllInOne/out/export/SLangRender/SLangRender.module.slb", "name": "SLangRender" },
    { "path": "D:/project/lang/SlangAllInOne/out/export/SLangQT/SLangQT.module.json", "name": "SLangQT" }
  ],
  "struct": [
    { "class": "RDataHost" },
    { "class": "RDataGallery" }
  ],
  "export": {
    "moduleName": "RDataGallery",
    "outputDir": "D:\\project\\lang\\SlangAllInOne\\out\\export",
    "versionMain": 0,
    "versionSub": 1,
    "versionPatch": 0,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "", "code": false, "token": false, "node": false,
      "file": false, "meta": false, "ir": false
    }
  },
  "publish": {
    "mode": "both",
    "gui": true,
    "outputDir": "publish",
    "config": "Release"
  },
  "qtRuntime": {
    "enabled": true,
    "qt6Dir": "C:\\Qt\\6.8.1\\msvc2022_64",
    "debugRuntime": false,
    "targetDir": "lib/windows",
    "modules": [],
    "plugins": {
      "platforms": ["qwindows", "qoffscreen", "qminimal"],
      "styles": ["qmodernwindowsstyle"],
      "imageformats": ["qgif", "qico", "qjpeg"],
      "iconengines": [], "sqldrivers": [], "tls": [], "networkinformation": [], "generic": []
    },
    "extraBinDlls": ["opengl32sw.dll"]
  },
  "global": { "imports": [] },
  "compileFilter": { "isAllGroup": true, "isAllTag": true }
}
