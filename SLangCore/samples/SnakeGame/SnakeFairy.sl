import SimGameEngine;
import Std;
import Core;

# SnakeFairy - FairyGUI screens for SnakeGame (2026-11-19).
# Assets: fairyui\ (atlas.png + package.xml + component.xml, generated by
# make-fairyui.ps1). Adapter limits: fairy "text" is a white-block
# placeholder (no runtime font), so static labels are pre-rendered into the
# atlas and dynamic values (time / score / rank rows) are drawn via a digit
# glyph quad pool through the engine FairyPackage dynamic quad API
# (addQuad / quadSetSprite / quadSetRect / quadSetHidden) - the game module
# never touches FairyQuad fields directly (cross-module object pollution).
#
# Quad naming: group prefixes m_ (main menu) / h_ (HUD) / r_ (rank panel);
# interactive quads carry "menu_" (buttons) or "chk" (checkboxes) so
# FairyUIRenderer.hitTopLocal picks only interactive targets.
# Actions returned by handleMouse: 1=start, 2=rank, 3=sound checkbox,
# 4=bgm checkbox, 5=quit, 6=back.
public class SnakeFairy
{
    static FairyPackage pkg = null
    static FairyUIRenderer ren = null
    static bool ok = false
    static string lastError = ""
    static string fairyDir = ""
    # checkbox 视觉状态（toggleSfx/toggleBgm 翻转后 refreshChecks 换装）
    static bool sfxChecked = true
    static bool bgmChecked = true
    # 数字 quad 池（**基准 = poolBase = 装载后的静态 quad 数**，池 quad 由
    # addQuad 追加在其后）：+0..4 时间 "mm:ss"、+5..8 分数（4 槽）、
    # +9..+88 排行榜 8 行 × 10 槽。**基准必须从静态数起算**——此前从 0
    # 起算，hidePool/writeText 把静态 UI quad 一并置零（x=-9999,y=0,w=0）
    # → 整个 FairyUI 不可见（2026-11-19 第四轮根修）。
    static Int32 poolBase = 0
    static Int32 poolTime = 0
    static Int32 poolScore = 0
    static Int32 poolRank = 0
    static Int32 poolTotal = 89
    # 引擎 InputSystem 引用（SnakeGame.start 注入；鼠标查询统一走它）
    static InputSystem input = null

    public static void setInput( InputSystem inp )
    {
        input = inp
    }
    # 排行榜数据（分数/秒数，分数降序 top8）
    static List<Int32> rankScore = List<Int32>( 0 )
    static List<Int32> rankTime = List<Int32>( 0 )

    static string findFairyDir()
    {
        string cwd = IO.Directory.getCurrentDirectory()
        string p1 = cwd + "/fairyui"
        bool e1 = File.exists( p1 + "/package.xml" )
        if e1
        {
            ret p1
        }
        string p2 = cwd + "/SLangCore/Lib/SLang/SimGameEngine/gameExample/SnakeGame/fairyui"
        bool e2 = File.exists( p2 + "/package.xml" )
        if e2
        {
            ret p2
        }
        string p3 = "D:/project/lang/SlangAllInOne/SLangCore/Lib/SLang/SimGameEngine/gameExample/SnakeGame/fairyui"
        bool e3 = File.exists( p3 + "/package.xml" )
        if e3
        {
            ret p3
        }
        ret ""
    }

    public static bool load()
    {
        if ok
        {
            ret true
        }
        string dir = findFairyDir()
        if dir == ""
        {
            lastError = "fairyui dir not found"
            ret false
        }
        FairyPackage p = FairyPackage()
        bool l = p.load( dir )
        if !l
        {
            lastError = p.lastError
            ret false
        }
        pkg = p
        # 数字 glyph 池基准 = 静态 quad 数（addQuad 追加其后）
        poolBase = pkg.quadCount()
        poolTime = poolBase
        poolScore = poolBase + 5
        poolRank = poolBase + 9
        Int32 i = 0
        while i < poolTotal
        {
            pkg.addQuad()
            i = i + 1
        }
        FairyUIRenderer r = FairyUIRenderer()
        r.pkg = pkg
        ren = r
        fairyDir = dir
        ok = true
        refreshChecks()
        Console.println( "[fairy] loaded " + pkg.quadCount().toString() + " quads from " + dir )
        ret true
    }

    public static bool ready()
    {
        ret ok
    }

    # 包引用（Go3DDemo 绑定 go3d 元素纹理用）
    public static FairyPackage pkg()
    {
        ret pkg
    }

    public static string statusText()
    {
        if ok
        {
            ret "ui=" + pkg.quadCount().toString() + "q"
        }
        ret "ui=off(" + lastError + ")"
    }

    # ── 组显隐（前缀匹配；隐藏 = x 挪画布外，渲染裁剪不可见）─────

    static bool nameStarts( string s, string prefix )
    {
        Int32 pl = prefix.length
        if s.length < pl
        {
            ret false
        }
        string head = SystemStringRange( s, 0, pl )
        ret head == prefix
    }

    static void showGroup( string prefix, bool on )
    {
        Int32 n = pkg.quadCount()
        Int32 i = 0
        while i < n
        {
            string nm = pkg.quadName( i )
            if nameStarts( nm, prefix )
            {
                pkg.quadSetHidden( i, !on )
            }
            i = i + 1
        }
    }

    # 数字池整体隐藏（仅池区间 [poolBase, poolBase+poolTotal)；切状态时
    # 清残留——HUD 数字/排行行属动态 quad，不在任何组前缀里，必须显式清）
    static void hidePool()
    {
        Int32 i = poolBase
        while i < poolBase + poolTotal
        {
            pkg.quadSetRect( i, 0.0f - 9999.0f, 0.0f, 0.0f, 0.0f )
            i = i + 1
        }
    }

    # 状态 → 界面组合：0 菜单 / 1 游戏 / 2 暂停 / 3 结束(带游戏结束标题的
    # 排行榜) / 4 排行榜
    public static void setState( Int32 st )
    {
        if !ok
        {
            ret
        }
        hidePool()
        showGroup( "m_", st == 0 )
        showGroup( "h_", st == 1 || st == 2 )
        Int32 pi = pkg.quadIndex( "h_pause" )
        pkg.quadSetHidden( pi, st != 2 )
        Int32 pp = pkg.quadIndex( "h_t_paused" )
        pkg.quadSetHidden( pp, st != 2 )
        showGroup( "r_", st == 3 || st == 4 )
        Int32 ov = pkg.quadIndex( "r_t_over" )
        pkg.quadSetHidden( ov, st != 3 )
        if st == 3
        {
            renderRank()
        }
        if st == 4
        {
            renderRank()
        }
    }

    # ── 数字文本池 ──────────────────────────────────────────────

    # 单槽：on=true 按字形绘制，false 隐藏（挪画布外）
    static void setSlot( Int32 slot, Float32 x, Float32 y, string spriteName, Float32 gw, Float32 gh, bool on )
    {
        if on
        {
            pkg.quadSetSprite( slot, spriteName )
            pkg.quadSetRect( slot, x, y, gw, gh )
        }
        else
        {
            pkg.quadSetRect( slot, 0.0f - 9999.0f, 0.0f, 0.0f, 0.0f )
        }
    }

    # 把 s 画到 (x,y)；'0'-'9' → dN (12x20)，':' → dcolon (8x20)，其余
    # 字符占 7px 空位。返回下一个可用槽位。
    static Int32 writeText( Int32 baseIdx, Float32 x, Float32 y, string s )
    {
        Int32 i = 0
        Int32 n = s.length
        Int32 slot = baseIdx
        Float32 xcur = x
        while i < n
        {
            Int32 c = SystemStringCharCodeAt( s, i )
            bool drew = false
            if c >= 48 && c <= 57
            {
                string nm = "d" + SystemStringRange( s, i, i + 1 )
                setSlot( slot, xcur, y, nm, 12.0f, 20.0f, true )
                drew = true
                xcur = xcur + 13.0f
            }
            if c == 58
            {
                setSlot( slot, xcur, y, "dcolon", 8.0f, 20.0f, true )
                drew = true
                xcur = xcur + 9.0f
            }
            if !drew
            {
                setSlot( slot, xcur, y, "", 0.0f, 0.0f, false )
                xcur = xcur + 7.0f
            }
            slot = slot + 1
            i = i + 1
        }
        ret slot
    }

    static string pad2( Int32 v )
    {
        if v < 10
        {
            ret "0" + v.toString()
        }
        ret v.toString()
    }

    static string pad4( Int32 v )
    {
        string s = v.toString()
        while s.length < 4
        {
            s = "0" + s
        }
        ret s
    }

    # HUD 时间/分数（每帧调用；quad 写入廉价）
    public static void updateHud( Int64 playMs, Int32 score )
    {
        if !ok
        {
            ret
        }
        Int32 sec = SystemConvertInt32( playMs / 1000 )
        Int32 mm = sec / 60
        Int32 ss = sec - mm * 60
        string ts = pad2( mm ) + ":" + pad2( ss )
        writeText( poolTime, 66, 13, ts )
        writeText( poolScore, 252, 13, pad4( score ) )
    }

    # ── 排行榜（rank.txt：每行 "score,seconds"，追加式记录）─────

    static string rankPath()
    {
        string d = SnakeSfx.dataDir()
        if d == ""
        {
            ret ""
        }
        ret d + "/rank.txt"
    }

    # 死亡时记录一局（分数 + 存活秒数）
    public static void recordScore( Int32 sc, Int32 sec )
    {
        string path = rankPath()
        if path == ""
        {
            ret
        }
        string line = sc.toString() + "," + sec.toString() + "\n"
        File.appendText( path, line )
    }

    static void loadRank()
    {
        rankScore.clear()
        rankTime.clear()
        string path = rankPath()
        if path == ""
        {
            ret
        }
        if !File.exists( path )
        {
            ret
        }
        string text = File.readAllText( path )
        Int32 n = text.length
        Int32 i = 0
        Int32 segStart = 0
        while i <= n
        {
            bool brk = false
            if i == n
            {
                brk = true
            }
            else
            {
                Int32 c = SystemStringCharCodeAt( text, i )
                if c == 10
                {
                    brk = true
                }
                if c == 13
                {
                    brk = true
                }
            }
            if brk
            {
                if i > segStart
                {
                    string seg = SystemStringRange( text, segStart, i )
                    Int32 cn = seg.length
                    Int32 k = 0
                    Int32 comma = 0 - 1
                    while k < cn
                    {
                        Int32 cc = SystemStringCharCodeAt( seg, k )
                        if cc == 44
                        {
                            comma = k
                            k = cn
                        }
                        else
                        {
                            k = k + 1
                        }
                    }
                    if comma > 0
                    {
                        string a = SystemStringRange( seg, 0, comma )
                        string b = SystemStringRange( seg, comma + 1, cn )
                        rankScore.add( FairySprite.parseI32( a ) )
                        rankTime.add( FairySprite.parseI32( b ) )
                    }
                }
                segStart = i + 1
            }
            i = i + 1
        }
        sortTop()
    }

    # 选择法取分数最高的前 8 局（List 内联表操作，不动跨模块对象）
    static void sortTop()
    {
        Int32 total = rankScore.length
        Int32 take = total
        if take > 8
        {
            take = 8
        }
        List<Int32> sc = List<Int32>( 0 )
        List<Int32> tm = List<Int32>( 0 )
        List<Int32> used = List<Int32>( 0 )
        Int32 i = 0
        while i < total
        {
            used.add( 0 )
            i = i + 1
        }
        Int32 k = 0
        while k < take
        {
            Int32 best = 0 - 1
            Int32 bi = 0 - 1
            i = 0
            while i < total
            {
                Int32 u = used[i]
                if u == 0
                {
                    Int32 v = rankScore[i]
                    if best < 0
                    {
                        best = v
                        bi = i
                    }
                    elif v > best
                    {
                        best = v
                        bi = i
                    }
                }
                i = i + 1
            }
            if bi < 0
            {
                break
            }
            used[bi] = 1
            sc.add( best )
            tm.add( rankTime[bi] )
            k = k + 1
        }
        rankScore = sc
        rankTime = tm
    }

    static void renderRank()
    {
        # 先清空 8 行槽位，再按 top8 回填；无记录时显示「暂无记录」
        Int32 i = poolRank
        while i < poolTotal
        {
            pkg.quadSetRect( i, 0.0f - 9999.0f, 0.0f, 0.0f, 0.0f )
            i = i + 1
        }
        loadRank()
        Int32 n = rankScore.length
        Int32 nd = pkg.quadIndex( "r_t_nodata" )
        if n == 0
        {
            pkg.quadSetHidden( nd, false )
        }
        else
        {
            pkg.quadSetHidden( nd, true )
        }
        Int32 r = 0
        while r < n
        {
            Int32 slot = poolRank + r * 10
            Int32 y = 150 + r * 32
            Int32 sc = rankScore[r]
            Int32 tm = rankTime[r]
            Int32 mm = tm / 60
            Int32 ss = tm - mm * 60
            string rn = ( r + 1 ).toString()
            string psc = pad4( sc )
            string tstr = pad2( mm ) + ":" + pad2( ss )
            # 实参一律局部变量（表达式/方法调用作实参解析崩，troubleshooting/06）
            Float32 ax = 90.0f
            Float32 ay = y.toFloat32() + 2.0f
            Float32 bx = 150.0f
            Float32 cx = 280.0f
            Int32 s0 = slot
            Int32 s1 = slot + 1
            Int32 s5 = slot + 5
            writeText( s0, ax, ay, rn )
            writeText( s1, bx, ay, psc )
            writeText( s5, cx, ay, tstr )
            r = r + 1
        }
    }

    # ── checkbox 换装 ───────────────────────────────────────────

    static void refreshChecks()
    {
        if !ok
        {
            ret
        }
        Int32 i1 = pkg.quadIndex( "m_chk_sound" )
        string s1 = "chk_on"
        if !sfxChecked
        {
            s1 = "chk_off"
        }
        pkg.quadSetSprite( i1, s1 )
        Int32 i2 = pkg.quadIndex( "m_chk_music" )
        string s2 = "chk_on"
        if !bgmChecked
        {
            s2 = "chk_off"
        }
        pkg.quadSetSprite( i2, s2 )
    }

    public static bool toggleSfx()
    {
        sfxChecked = !sfxChecked
        refreshChecks()
        ret sfxChecked
    }

    public static bool toggleBgm()
    {
        bgmChecked = !bgmChecked
        refreshChecks()
        ret bgmChecked
    }

    # ── 鼠标（左键按下沿 → 命中交互项 → 动作码）────────────────
    # 2026-11-19 第五轮：输入统一走引擎 InputSystem（QTHost.pumpMouse
    # 帧首把 QT 鼠标采样注入引擎 C 表），本类不再直读 QT。

    public static Int32 handleMouse( Int32 viewW, Int32 viewH )
    {
        if !ok
        {
            ret 0
        }
        if input == null
        {
            ret 0
        }
        Int32 btnL = InputSystem.MOUSE_LEFT
        bool edge = input.mousePressed( btnL )
        if !edge
        {
            ret 0
        }
        # 引擎表存窗口客户区坐标；画布 QLabel 位于 (10,10)（第四轮布局）
        Int32 lx = input.mouseX() - 10
        Int32 ly = input.mouseY() - 10
        string hit = ren.hitTopLocal( lx, ly, viewW, viewH )
        if hit == "m_menu_0"
        {
            ret 1
        }
        if hit == "m_menu_1"
        {
            ret 2
        }
        if hit == "m_chk_sound"
        {
            ret 3
        }
        if hit == "m_chk_music"
        {
            ret 4
        }
        if hit == "h_menu_2"
        {
            ret 5
        }
        if hit == "r_menu_3"
        {
            ret 6
        }
        ret 0
    }

    # 每帧 UI 提交（sync 之后、frame 之前）；lastDrawOk/lastDrawError 供诊断
    static bool lastDrawOk = false
    static string lastDrawError = ""

    public static bool draw( RenderSystem rs )
    {
        if !ok
        {
            lastDrawOk = false
            lastDrawError = "not loaded"
            ret false
        }
        bool r = ren.draw( rs )
        lastDrawOk = r
        if !r
        {
            lastDrawError = ren.lastError
        }
        ret r
    }

    public static string drawStatus()
    {
        if lastDrawOk
        {
            ret "uiok " + ren.lastQuads.toString() + "q/" + ren.lastVerts.toString() + "v"
        }
        ret "uiFAIL " + lastDrawError
    }
}
