<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SlangAllInOne</RootNamespace>
    <!-- 发布产物名：slang.exe / slang.dll（工程目录与命名空间保持 SlangAllInOne） -->
    <AssemblyName>slang</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="resources\S语言图标-方案B-极简线性.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- FrontEnd: SimpleLanguage compiler (in-process compile) -->
    <ProjectReference Include="..\simple_language\source\Front\SimpleLanguageFront.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="resources\S语言图标-方案B-极简线性.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- C VM config that feeds the packaged runtime: follows the publish
       configuration (-c Debug / -c Release); override with -p:CvmBuildConfig. -->
  <PropertyGroup>
    <CvmBuildConfig Condition="'$(CvmBuildConfig)' == '' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Release')">$(Configuration)</CvmBuildConfig>
    <CvmBuildConfig Condition="'$(CvmBuildConfig)' == ''">Release</CvmBuildConfig>
    <CvmBinDir>$(MSBuildThisFileDirectory)..\csimple_lang\build\$(CvmBuildConfig)\bin</CvmBinDir>
    <ApplicationIcon>resources\S语言图标-方案B-极简线性.ico</ApplicationIcon>
    <PackageId>simple_language.kamaba233.dingo.com</PackageId>
    <Authors>kamaba233</Authors>
    <PackageIcon>S语言图标-方案B-极简线性.png</PackageIcon>
  </PropertyGroup>

  <!-- Publish is self-contained: build the C VM tree (incremental Ninja build,
       a no-op when unchanged) and pack the runtime next to the app under bin\
       so the output depends only on its own directory.
       CvmBackend.Locate prefers <app dir>\bin\ over the dev build trees. -->
  <Target Name="PackCvmRuntime" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\build-vm-win.ps1&quot; -Config $(CvmBuildConfig)" />
    <ItemGroup>
      <CvmRuntimeFiles Include="$(CvmBinDir)\csimple_lang_dll.dll" />
      <CvmRuntimeFiles Include="$(CvmBinDir)\sqlite3.dll" />
      <!-- Debug-symbol sidecar so the packaged C VM can be debugged
           (attach to slang.exe and break in csimple_lang sources;
           the PDB source paths match this repo checkout). -->
      <CvmRuntimeFiles Include="$(CvmBinDir)\csimple_lang_dll.pdb" Condition="Exists('$(CvmBinDir)\csimple_lang_dll.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(CvmRuntimeFiles)" DestinationFolder="$(PublishDir)bin\" SkipUnchangedFiles="true" />
  </Target>

  <!-- Official release packaging: compile the standard library modules
       (Core, then Math, then Std; R15: format binary + export-json = SLB
       main + json debug copy) and pack them flat under <package>\module\
       (one directory, no per-module sub-trees). The deep relative paths
       embedded in the modules (moduleReferences "../Core", FFI dllImports
       "../../out/export/Math/math_lib.dll") resolve through the C VM
       loader fallbacks: references retry <dir>\<basename>.module.json
       (json OR slb, SLB-preferred) and FFI retries <pkg_dir>\<basename>.
       Debug package keeps .module.slb + .module.json; Release keeps only
       the mandatory .slb (+ math_lib.dll).
       The whole build recipe lives in the app itself
       (Pack/PackModulesCommand.cs) and runs here through the just-published
       exe: one clean child process per module, same model as
       CompileCore/CompileMath/CompileStd. A non-zero exit fails the publish
       (never ship a broken package). -->
  <Target Name="PackStdModules" AfterTargets="PackCvmRuntime">
    <Exec Command="&quot;$(PublishDir)$(AssemblyName).exe&quot; pack-modules --config $(CvmBuildConfig)" />
  </Target>

  <!-- Official release packaging: copy the user-facing FrontEnd markdown docs
       (md root entry docs + syntax/lib/project/log/plugins mirrors + per-library
       notes under source\Front\Lib) into <package>\md\. Internal trees (md\ai\,
       md\vm\) and cvm_* C-side project docs are excluded. Recipe lives in
       Pack/PackDocsCommand.cs and runs here through the just-published exe,
       same self-bootstrap model as pack-modules. -->
  <Target Name="PackDocs" AfterTargets="PackStdModules">
    <Exec Command="&quot;$(PublishDir)$(AssemblyName).exe&quot; pack-docs" />
  </Target>

  <!-- Release-package hygiene (part 1/2, BEFORE the publish copy): dotnet
       publish never cleans the output directory, so stale files from older
       publishes (old host/frontend assemblies, test scratch dirs, runtime
       build\logs) would accumulate forever. Wipe the whole package directory
       first so the result contains ONLY what the current publish produces.
       NOTE: must hook _CopyFilesToPublishFolder, NOT Publish — a
       BeforeTargets="Publish" hook runs AFTER Publish's dependency chain
       (which already copied the files), so it would delete the fresh output
       and the pack targets would then find no slang.exe (MSB3073/9009).
       Guarded by "the PublishDir lies under a package folder" so an
       accidental "publish -o <precious dir>" cannot wipe anything unrelated. -->
  <Target Name="WipeReleasePackage" BeforeTargets="_CopyFilesToPublishFolder" Condition="'$(Configuration)' == 'Release' and $([System.String]::Copy('$(PublishDir)').Contains('package'))">
    <RemoveDir Directories="$(PublishDir)" Condition="Exists('$(PublishDir)')" />
    <MakeDir Directories="$(PublishDir)" />
  </Target>

  <!-- Release-package hygiene (part 2/2, AFTER all pack targets): the runtime
       package keeps only what is needed at run time.
         - SimpleLanguageFront.exe: the Front CLI apphost of a referenced Exe
           project. The host compiles in-process through SimpleLanguageFront.dll
           (and pack-modules bootstraps via this app's own exe), so the CLI
           host is dead weight in the package. The .dll itself stays (needed).
         - SimpleLanguageFront.deps.json / .runtimeconfig.json: same story as
           the exe — dependency resolution and TFM binding run against the
           host's own slang.deps.json / slang.runtimeconfig.json.
         - *.pdb in the package root: no debugging value in the runtime
           package (plugin frontend pdbs, referenced project pdbs). The C VM
           sidecar pdb under bin\ is handled by PackCvmRuntime's Exists()
           condition and is not packed for Release builds.
       Plugin frontend dlls (SLCSharpMonoFrontend/SLJavaHotspotFrontend)
       stay: Front loads them via reflection when compiling plugin projects. -->
  <Target Name="TrimReleasePackage" AfterTargets="PackDocs" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ReleaseJunk Include="$(PublishDir)SimpleLanguageFront.exe" />
      <ReleaseJunk Include="$(PublishDir)SimpleLanguageFront.deps.json" />
      <ReleaseJunk Include="$(PublishDir)SimpleLanguageFront.runtimeconfig.json" />
      <ReleaseJunk Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(ReleaseJunk)" />
  </Target>

</Project>
