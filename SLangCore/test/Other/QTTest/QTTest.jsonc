{
  "project": {
    "name": "QTTest",
    "desc": "slQT smoke test - SLangQT module end-to-end (native dll preload / factories / bind)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "QTTest.sl", "group": "qt", "tag": "base", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "references": [
    { "path": "./lib/Core.module.slb" },
    { "path": "./lib/Std.module.slb" },
    // SLangQT = spm 包形态模块（package-layout §二.6 / publish-guide §6）：
    // 产物装在工程 modules\SLangQT\（slb + json + slang_qt.dll，cvm\build-slqt.ps1
    // 步骤 5 一键打包）；原生 dll 经模块 dllImports FFI 预载（pkg_dir 平铺命中）。
    { "path": "./modules/SLangQT" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "QTTest",
    "outputDir": "export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true
  },
  "publish": {
    "mode": "both",
    "gui": true,
    "outputDir": "publish"
  }
}
