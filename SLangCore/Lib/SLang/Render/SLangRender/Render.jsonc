{
  "project":
  {
    "name": "SLangRender",
    "desc": "Offscreen GPU render library module - namespace SLang: Render (entry + native bindings) / RenderContext (FBO render target) / RenderPipeline + RenderObject + RenderTexture + RenderCamera (13-stage pipeline facade), backed by sl_render_lib.dll (WGL hidden window + OpenGL 3.3 core context, zero toolkit dependency - opengl32.dll resolved at runtime)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  // FFI 导入表（jsonc "dllImports" 段）。"static" 非空（静态注册名）时 cvm 加载
  // SL 模块即预载该库并注册进 FFI.StaticLibrary，@DllStaticImport("sl_render_lib",
  // "slr_init") 静态调用点由 cvm 装配期 attribute 注册表改写为 CallFFIStatic(77)
  // 直调绑定表。绑定失败（库未注册 / 符号缺失）时回退 SL 函数体兜底（返回
  // -1/false/0，initialize() == false 即兜底征兆）。"alias" 仍供 @DllImport
  // 三参形式按别名解析 path（运行时相对进程 CWD 解析）。
  "dllImports":
  [
    { "path": "sl_render_lib.dll", "name": "sl_render_lib", "alias": "sl_render_lib", "static": "sl_render_lib" }
  ],
  // vmDlls 构建规则：导出 SL 模块时，Front 用 MSBuild 编译 project 指向的 VS 工程
  // （路径相对本 jsonc 所在目录），并把产出的 sl_render_lib.dll 拷贝到与
  // SLangRender.module.json 相同的目录（out/export/SLangRender/），即上方
  // dllImports 别名指向的位置。
  // C 实现位于 SlangAllInOne\SLangCore\Lib\SLang\Render\cvm_render_lib\sl_render_lib.c
  // （FFI 普通 C ABI：slr_*）。零外部依赖：WGL（wglCreateContextAttribsARB /
  // wglChoosePixelFormatARB）与 GL 3.3 core 函数（glCreateShader / glDrawArrays /
  // glReadPixels ...）全部运行期从 opengl32.dll（系统自带）LoadLibrary +
  // wglGetProcAddress / GetProcAddress 解析，构建与运行均不需要 OpenGL SDK
  // 头文件或 .lib，产物 DLL 自包含。渲染走隐藏窗口 + FBO 离屏目标，回读
  // RGBA8 像素到调用方原生块（renderTexture 通道，供 QT QLabel 等窗口填充）。
  "vmDlls": [
    { "project": "../cvm_render_lib/cvm_sl_render_lib.vcxproj", "name": "sl_render_lib.dll", "configuration": "Debug", "platform": "x64" }
  ],
  // systemCalls：本模块全部能力走 @DllStaticImport 静态绑定直调，不下沉 cvm
  // SystemMethodCall，故留空。
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "Render.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 0 },
      // RenderData —— P0 数据层三类（CullingData/FrameData/PassData），纯数据
      // 零 FFI 零依赖；与 Render.sl 同级 priority 0，先于 Pipeline(2)/CommandBuffer(22)
      { "path": "Pipeline/RenderData.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 0 },
      // RenderFFI —— 新增后端调用单点（@DllStaticImport 声明处，doc/05 规则 11）；
      // 必须先于消费方 Pipeline.sl 编译
      { "path": "Pipeline/RenderFFI.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 1 },
      { "path": "Pipeline/Pipeline.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 2 },
      { "path": "Mesh.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 3 },
      // ---- 场景层草稿并入编译集（2026-11-12，基类在前）----
      { "path": "Config.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 4 },
      { "path": "Vector.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 5 },
      { "path": "Vertex.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 6 },
      { "path": "Texture.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 7 },
      { "path": "Shader.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 8 },
      { "path": "Material.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 9 },
      { "path": "Transform.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 10 },
      { "path": "RectTransform.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 11 },
      { "path": "Renderer.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 12 },
      { "path": "Ray.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 13 },
      { "path": "Camera/Camera.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 14 },
      { "path": "Camera/Light.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 15 },
      // ---- RHI 层草稿（依赖序：资源 -> 设备 -> 命令 -> 管线状态）----
      { "path": "Pipeline/GfxBackend.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 16 },
      { "path": "Pipeline/GpuResource.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 17 },
      { "path": "Pipeline/GpuTexture.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 18 },
      { "path": "Pipeline/GfxDevice.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 19 },
      { "path": "Pipeline/PipelineState.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 20 },
      { "path": "Pipeline/RootSignature.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 21 },
      { "path": "Pipeline/CommandBuffer.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 22 },
      { "path": "Pipeline/CommandQueue.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 23 },
      { "path": "Pipeline/RenderTarget.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 24 },
      { "path": "Pipeline/RenderTexture.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 25 },
      { "path": "Pipeline/PlatformWindow.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 26 },
      { "path": "Pipeline/Hlsl.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 27 },
      { "path": "Pipeline/HlslLibrary.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 28 },
      // Feature —— P2 Feature 机制（注入点/Volume 栈/RenderFeature/CustomPass/
      // ColorOverlayFeature；消费 CommandBuffer(22)，被 RenderPipelineAsset(30)/
      // ScriptableRenderContext(31)/PipelineDemo(34) 消费）
      { "path": "Pipeline/Feature.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 28 },
      // ---- SRP 草稿（RenderPipeline 类与 Pipeline.sl 的 SLang.RenderPipeline
      //      同名冲突，草稿基类改名 ScriptableRenderPipeline）----
      { "path": "Pipeline/RenderPass.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 29 },
      { "path": "Pipeline/RenderPipeline.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 30 },
      { "path": "Pipeline/RenderCamera.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 30 },
      { "path": "Pipeline/RenderObject.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 30 },
      { "path": "Pipeline/ScriptableRenderContext.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 31 },
      { "path": "Pipeline/UniversalRenderPipeline.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 32 },
      // CameraRenderPipeline —— P3 资产层实例（消费 RenderPipelineAsset(30)/
      // Feature(28)/RenderData(0)/RenderPass(29)/Context(31)；Render.sl(0)
      // usePipeline 门面与 Pipeline.sl(2) renderCameraScene 路由为类型互引，
      // 先例 RenderPass(29)<->Context(31) 实证可编）
      { "path": "Pipeline/CameraRenderPipeline.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 33 },
      // PipelineDemo —— P3 起改走资产->实例->Render(FrameData) 新入口
      { "path": "Pipeline/PipelineDemo.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 34 },
      // Environment —— 渲染环境查询类（根级 RenderEnvironment：查明
      // 支持后端/当前选择/硬件条件/资源占用/当前渲染配置 + P4 帧级统计）；
      // 消费 RenderFFI 计数绑定（priority 1）、CommandBuffer 常量（22）与
      // ScriptableRenderContext 帧级静态（31），置于其后
      { "path": "Environment.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 35 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "references": [
    // Memory.alloc / readUInt8 / writeF32 等来自 Core（本 jsonc 位于
    // SLangCore\Lib\SLang\Render\SLangRender\，上 3 级到 SLangCore\Lib\，
    // 同层即 Core 包）
    { "path": "../../../Core", "name": "Core" },
    // Component（Transform/Camera/Light/Renderer 的基类，Std 根级类，裸名可见）
    { "path": "../../../Std", "name": "Std" },
    { "path": "../../../Math", "name": "Math" },
    // 图像编解码独立模块 SLangImage（namespace Image：ImageBuffer/ImageIO/
    // ImageInfo/Png/Jpeg/Webp/Svg，后端 sl_image_lib.dll）。原 SLangRender\
    // Image\ 目录 8 个 .sl 副本已删除，纹理数据源（doc/06 数据流）统一走本
    // 模块引用；用方文件需 `import SLangImage;` 后以 Image.xxx 限定访问。
    // spm 模式（2026-11-12，§4.9 module 检查机制）：装载前检查工程
    // modules\SLangImage\ 是否正确（清单 version==1.0.0 且本地 zip md5
    // 一致），不正确/未装 → <lang>\modules\SLangImage.zip（md5 校验）
    // 强制重装纠正；zip 缺失走 official 渠道 registry 检索。
    { "type": "module", "name": "SLangImage", "channel": "official", "version": "1.0.0" }
  ],
  "struct": [
    { "namespace": "SLang", "children": [
      { "class": "Render" },
      { "class": "RenderContext" },
      { "class": "RenderPipeline" },
      { "class": "RenderObject" },
      { "class": "RenderTexture" },
      // P4：RT 句柄池（固定容量 64，按 (w,h) 复用；RenderTexture 保持薄壳）
      { "class": "RTHandlePool" },
      { "class": "RenderCamera" },
      { "class": "Mesh" }
    ]},
    // ---- 根级类型（草稿无 namespace 声明，注册到模块根，引用方裸名可见，
    //      同 Std Component/ColorInt 先例）----
    // 场景层
    { "class": "Config" },
    { "class": "Vector" },
    { "class": "Vertex" },
    { "class": "Texture" },
    { "class": "Shader" },
    { "class": "Material" },
    { "class": "Transform" },
    { "class": "RectTransform" },
    { "class": "Renderer" },
    { "class": "Camera" },
    { "class": "Light" },
    { "class": "Ray" },
    // RHI 层
    { "enum": "EGraphicsBackend" },
    { "enum": "ED3DFeatureLevel" },
    { "enum": "EGLProfile" },
    { "class": "GfxDeviceDescriptor" },
    { "class": "GfxCapabilities" },
    { "class": "GfxBackend" },
    { "enum": "EResourceState" },
    { "enum": "EHeapType" },
    { "class": "GpuResource" },
    { "class": "GpuBuffer" },
    { "class": "VertexBuffer" },
    { "class": "IndexBuffer" },
    { "class": "ConstantBuffer" },
    { "class": "GpuUtil" },
    { "enum": "ETextureFormat" },
    { "enum": "ETextureDimension" },
    { "enum": "ETextureUsage" },
    { "enum": "ETextureViewType" },
    { "enum": "EFilterMode" },
    { "enum": "EAddressMode" },
    { "class": "SamplerDesc" },
    { "class": "GpuTextureView" },
    { "class": "GpuTexture" },
    { "class": "Sampler" },
    { "class": "GfxDevice" },
    { "enum": "EBlendFactor" },
    { "enum": "EBlendOp" },
    { "enum": "ECullMode" },
    { "enum": "EFillMode" },
    { "enum": "ECompareFunction" },
    { "enum": "EStencilOp" },
    { "enum": "EPrimitiveTopology" },
    { "enum": "EVertexAttribute" },
    { "enum": "EVertexAttributeFormat" },
    { "class": "BlendState" },
    { "class": "RasterizerState" },
    { "class": "DepthStencilState" },
    { "class": "VertexInputLayout" },
    { "class": "GraphicsPipelineState" },
    { "class": "ComputePipelineState" },
    { "enum": "EShaderVisibility" },
    { "enum": "EDescriptorType" },
    { "enum": "ERootParameterType" },
    { "class": "RootParameter" },
    { "class": "RootSignature" },
    { "class": "DescriptorHeap" },
    // RenderFFI —— 原生 FFI 静态绑定单点（新增后端调用声明处）
    { "class": "RenderFFI" },
    // ECommandOpcode —— opcode 值表改 Int32 静态常量类（2026-11-13：
    // 文件级 enum 成员编译为「最近类」静态槽索引，与 CommandBuffer 自身
    // 静态冲突/越界致录制 opcode 全坏；类静态通路经 Phase ENV 实证完好）
    { "class": "ECommandOpcode" },
    { "class": "CommandBuffer" },
    { "class": "CommandBufferPool" },
    { "enum": "ECommandQueueType" },
    { "class": "CommandAllocator" },
    { "class": "CommandList" },
    { "class": "Fence" },
    { "class": "CommandQueue" },
    { "class": "SwapChain" },
    { "class": "RenderTextureDescriptor" },
    { "class": "RenderTargetIdentifier" },
    { "class": "RenderTargetBinding" },
    { "class": "RenderTargetPool" },
    { "enum": "EWindowSystem" },
    { "class": "PlatformWindow" },
    { "class": "Win32Window" },
    { "class": "X11Window" },
    { "class": "MobileWindow" },
    { "enum": "EShaderStage" },
    { "enum": "EShaderParamType" },
    { "class": "ShaderParameter" },
    { "class": "ShaderModule" },
    { "class": "HlslShader" },
    { "class": "HlslLibrary" },
    // SRP 层（草稿 RenderPipeline 基类已改名 ScriptableRenderPipeline，
    // 避让 namespace SLang 下的 13 阶段管线门面 SLang.RenderPipeline）
    { "enum": "ERenderPassEvent" },
    { "class": "RenderPass" },
    { "class": "ClearPass" },
    { "class": "ShadowCasterPass" },
    { "class": "DepthPrepass" },
    { "class": "DrawObjectsPass" },
    { "class": "SkyboxPass" },
    { "class": "PostProcessPass" },
    // P1 可执行 Pass（RenderPass.sl：passType 派发 + 单流提交）
    { "class": "OpaquePass" },
    { "class": "TransparentPass" },
    { "class": "BlitPass" },
    { "class": "RenderPassList" },
    { "class": "ScriptableRenderPipeline" },
    { "class": "RenderPipelineAsset" },
    { "class": "RenderPipelineManager" },
    { "class": "CullingParameters" },
    { "class": "VisibleRenderer" },
    { "class": "CullingResults" },
    { "class": "ScriptableRenderContext" },
    { "enum": "EShadowQuality" },
    { "enum": "EShadowCascades" },
    { "class": "UniversalRenderPipelineAsset" },
    { "class": "UniversalRenderPipeline" },
    { "class": "PipelineDemo" },
    // RenderEnvironment —— 渲染环境查询（根级类；与 Core.Environment.Render
    // 平台层探测互补，本类为渲染库运行时视图。Core 已占 Environment.Render
    // 裸名，故取独立根级名）
    { "class": "RenderEnvironment" },
    // P0 数据层三类（根级类，RenderData.sl）
    { "class": "CullingData" },
    { "class": "FrameData" },
    { "class": "PassData" },
    // P3/P4 数据层扩展（根级类，RenderData.sl）：PerDraw 槽常量表 + 帧渲染配置
    { "class": "PerDrawData" },
    { "class": "FrameSettings" },
    // P2 Feature 机制（根级类，Feature.sl）：注入点值表 / Volume 参数与栈 /
    // RenderFeature 基类 / CustomPass 执行体 / 全屏色块示例
    { "class": "EInjectionPoint" },
    { "class": "VolumeProfile" },
    { "class": "VolumeStack" },
    { "class": "RenderFeature" },
    { "class": "CustomPass" },
    { "class": "ColorOverlayFeature" },
    // P3 资产层实例（根级类，CameraRenderPipeline.sl）：资产声明 ->
    // 实例装配 -> Render(FrameData)（SLang.Render.usePipeline 注册门面）
    { "class": "CameraRenderPipeline" },
    // P5 SL->C 程序枚举映射表（根级类，Hlsl.sl）
    { "class": "ShaderProgramMap" }
  ],
  "export": {
    "moduleName": "SLangRender",
    // jsonc 位于 SLangCore\Lib\SLang\Render\SLangRender\，上 5 级到
    // SlangAllInOne\out\export（GLRenderTest 引用 ../../../../out/export/SLangRender；
    // e2e StageReferencedModules 亦从 SlangAllInOne\out\export\SLangRender 拷贝）
    "outputDir": "..\\..\\..\\..\\..\\out\\export",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true,
    // Front 调试文本实际目录：{export.outputDir}/{export.moduleName}/DebugCode/；以下 outputDir 仅兼容旧字段，可为空。
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
