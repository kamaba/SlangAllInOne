{
  "project": {
    "name": "Playground",
    "desc": "Math test project - tests builtin member functions (_add_/_eq_/_getItem_ etc.) via Math module",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      {
        "path": "Playground.sl",
        "group": "math",
        "tag": "base",
        "ignore": false,
        "priority": 0
      }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "references": [
    {
      "path": "./lib/Core.module.slb"
    },
    {
      "path": "./lib/Std.module.slb"
    },
    {
      "path": "./lib/Math.module.slb"
    }
  ],
  "struct": [],
  "export": {
    "moduleName": "Playground",
    "outputDir": "export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  },
  "publish": {
    "mode": "both",
    "outputDir": "publish"
  }
}