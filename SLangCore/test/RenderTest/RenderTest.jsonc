{
  "project": {
    "name": "RenderTest",
    "desc": "angRender offscreen GL + SLangQT window fill e2e - color-shifting triangle (Phase A pure GL pixel assertions, Phase B QTimer frame loop -> QLabel.setPixmapRgba)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "RenderTest.sl", "group": "render", "tag": "base", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "references": [
    { "path": "./lib/Core.module.slb" },
    { "path": "./lib/Std.module.slb" },
    { "path": "./lib/Math.module.slb" },
    // spm 模式（2026-11-12，§4.9 module 检查机制）：装载前检查工程
    // modules\<名>\ 是否正确（清单 version 与声明一致 + 本地 zip md5 一致），
    // 不正确/未装 → <lang>\modules\<名>.zip（md5 校验）强制重装纠正；
    // zip 缺失走 official 渠道 registry 检索。模块版本取自各模块 jsonc
    // export 段（SLangQT 0.1.0 / SLangRender 1.0.0）。
    { "type": "module", "name": "SLangQT", "channel": "official", "version": "0.1.0" },
    { "type": "module", "name": "SLangRender", "channel": "official", "version": "1.0.0" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "RenderTest",
    "outputDir": "export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true
  }
}
