{
  "project":
  {
    "name": "SLangRender",
    "desc": "Offscreen GPU render library module - namespace SLang: Render (entry + native bindings) / RenderContext (FBO render target), backed by sl_render_lib.dll (WGL hidden window + OpenGL 3.3 core context, zero toolkit dependency - opengl32.dll resolved at runtime)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  // FFI 导入表（jsonc "dllImports" 段）。"static" 非空（静态注册名）时 cvm 加载
  // SL 模块即预载该库并注册进 FFI.StaticLibrary，@DllStaticImport("sl_render_lib",
  // "slr_init") 静态调用点由 cvm 装配期 attribute 注册表改写为 CallFFIStatic(77)
  // 直调绑定表。绑定失败（库未注册 / 符号缺失）时回退 SL 函数体兜底（返回
  // -1/false/0，initialize() == false 即兜底征兆）。"alias" 仍供 @DllImport
  // 三参形式按别名解析 path（运行时相对进程 CWD 解析）。
  "dllImports":
  [
    { "path": "sl_render_lib.dll", "name": "sl_render_lib", "alias": "sl_render_lib", "static": "sl_render_lib" }
  ],
  // vmDlls 构建规则：导出 SL 模块时，Front 用 MSBuild 编译 project 指向的 VS 工程
  // （路径相对本 jsonc 所在目录），并把产出的 sl_render_lib.dll 拷贝到与
  // SLangRender.module.json 相同的目录（out/export/SLangRender/），即上方
  // dllImports 别名指向的位置。
  // C 实现位于 SlangAllInOne\SLangCore\Lib\SLang\Render\cvm_sl_render_lib\sl_render_lib.c
  // （FFI 普通 C ABI：slr_*）。零外部依赖：WGL（wglCreateContextAttribsARB /
  // wglChoosePixelFormatARB）与 GL 3.3 core 函数（glCreateShader / glDrawArrays /
  // glReadPixels ...）全部运行期从 opengl32.dll（系统自带）LoadLibrary +
  // wglGetProcAddress / GetProcAddress 解析，构建与运行均不需要 OpenGL SDK
  // 头文件或 .lib，产物 DLL 自包含。渲染走隐藏窗口 + FBO 离屏目标，回读
  // RGBA8 像素到调用方原生块（renderTexture 通道，供 QT QLabel 等窗口填充）。
  "vmDlls": [
    { "project": "cvm_sl_render_lib/cvm_sl_render_lib.vcxproj", "name": "sl_render_lib.dll", "configuration": "Debug", "platform": "x64" }
  ],
  // systemCalls：本模块全部能力走 @DllStaticImport 静态绑定直调，不下沉 cvm
  // SystemMethodCall，故留空。
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "Render.sl", "group": "render", "tag": "gpu", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "references": [
    // Memory.alloc / readUInt8 / writeF32 等来自 Core（本 jsonc 位于
    // SLangCore\Lib\SLang\Render\，上 2 级到 SLangCore\Lib\，同层即 Core 包）
    { "path": "../../Core", "name": "Core" }
  ],
  "struct": [
    { "namespace": "SLang", "children": [
      { "class": "Render" },
      { "class": "RenderContext" }
    ]}
  ],
  "export": {
    "moduleName": "SLangRender",
    "outputDir": "..\\..\\..\\..\\out\\export",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true,
    // Front 调试文本实际目录：{export.outputDir}/{export.moduleName}/DebugCode/；以下 outputDir 仅兼容旧字段，可为空。
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
