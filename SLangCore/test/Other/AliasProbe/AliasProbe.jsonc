{
  "project":
  {
    "name": "AliasProbe",
    "desc": "import X as Y / typealias usage probe",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "AliasProbeLib.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {}
  },
  "references": [
    { "path": "./lib/Core.module.slb" },
    // name = 工程内别名（2026-10-18 用户规则）：import 按别名命中 Std 模块
    //（真实名 Std 经 ModuleManager 照常可用；导出侧回填真实 uuid/版本）
    { "path": "./lib/Std.module.slb", "name": "SLStd" }
  ],
  "struct": [
      { "namespace": "AliasNS", "children": [ { "namespace": "Sub", "children": [] } ] }
  ],
  "export": {
    "moduleName": "AliasProbe",
    "outputDir": "..\\..\\..\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": false,
      "token": false,
      "node": false,
      "file": false,
      "meta": false,
      "ir": false
    }
  },
  "publish": {
    "mode": "both",
    "outputDir": "publish"
  }
}
