{
  "project":
  {
    "name": "BenchMark",
    "desc": "BenchMark project - internal performance test cases (HelloWorld / Fibonacci / Loop / Levenshtein / DataTypes / StringBench / RegExpBench / NQueens / Sieve / QuickSort / MatrixMul / BinaryTree / Mandelbrot)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": true,
    "target": "x64",
    "debug": false,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "HelloWorld.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "EqBench.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "Fibonacci.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "Loop.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "Levenshtein.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "DataTypes.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "StringBench.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "RegExpBench.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "NQueens.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "Sieve.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "QuickSort.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "MatrixMul.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "BinaryTree.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "Mandelbrot.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std"
    ],
    "replace": {
      "DEBUG": "true"
    },
    "data": {
      "var1": 12,
      "arrvar1": [1, 2, 3, 4, 5],
      "vardata2": {
        "a": 10,
        "b": 20.1
      }
    }
  },
  "references": [
    { "path": "./lib/Core.module.slb" },
    { "path": "./lib/Std.module.slb" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "BenchMark",
    "outputDir": "..\\..\\..\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  },
  "publish": {
    "mode": "both",
    "outputDir": "publish",
    "config": "Release"
  }
}
