{
  // SLang.StatsPlot —— SLang 统计与绘图模块编译清单（标准库形态模块，
  // 与 QT/Image/SimGameEngine 同构：*.sp/*.jsonc/*.sl 在模块根，doc/ 文档集）。
  // 模块名 StatsPlot，namespace StatsPlot。
  // 定位：像 R 一样整合数据（DataFrame）+ 描述统计（Stats）+ 多图形显示
  // （Plot 六图表 + PlotCanvas 软光栅 + PlotIo 输出）。纯 SL，零原生依赖。
  // 构建：dotnet run --no-launch-profile --project simple_language\source\SimpleLanguageFront.csproj --
  //     compile -p SlangAllInOne\SLangCore\Lib\SLang\StatsPlot\StatsPlot.jsonc -e ir
  //     --no-banner --format binary+json
  "project": {
    "name": "StatsPlot",
    "desc": "R-like statistics & plotting for SLang - DataFrame (data.frame) + Stats (mean/median/sd/quantile/cor/table) + Plot (bar/line/scatter/hist/pie/boxplot) rendered by pure-SL PlotCanvas (RGBA8, feeds slQT QLabel.setPixmapRgba)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  // 纯 SL 模块：无 dllImports / vmDlls / systemCalls。
  // 引用顺序规则（SimGameEngine doc/10 实证）：Core/Std/Math 必须在前。
  "references": [
    // List/Array/String/Float32/Memory 等来自 Core（上 2 级到 SLangCore\Lib\）
    { "path": "../../Core", "name": "Core" },
    // Console / ColorInt 等（本模块暂未直接使用 Std 类，保留以利后续）
    { "path": "../../Std", "name": "Std" },
    // 饼图/椭圆切片的三角函数 Mathf.cos/sin（Plot.sl import Math）
    { "path": "../../Math", "name": "Math" }
  ],
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "Stats.sl", "group": "stats", "tag": "lib", "ignore": false, "priority": 0 },
      { "path": "DataFrame.sl", "group": "stats", "tag": "lib", "ignore": false, "priority": 1 },
      { "path": "PlotCanvas.sl", "group": "plot", "tag": "lib", "ignore": false, "priority": 2 },
      { "path": "Plot.sl", "group": "plot", "tag": "lib", "ignore": false, "priority": 3 },
      { "path": "PlotIo.sl", "group": "plot", "tag": "lib", "ignore": false, "priority": 4 },
      { "path": "StatsPlot.sp", "group": "entry", "tag": "lib", "ignore": false, "priority": 9 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [],
    "replace": {}
  },
  // namespace StatsPlot 下全部根级类型（加载端按此登记命名空间节点）
  "struct": [
    { "namespace": "StatsPlot", "children": [
      { "class": "DataFrame" },
      { "class": "StatsGroup" },
      { "class": "Stats" },
      { "class": "PlotCanvas" },
      { "class": "Plot" },
      { "class": "PlotIo" }
    ]}
  ],
  "export": {
    "moduleName": "StatsPlot",
    "outputDir": "..\\..\\..\\..\\out\\export",
    "versionMain": 0,
    "versionSub": 1,
    "versionPatch": 0,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": false,
      "token": false,
      "node": false,
      "file": false,
      "meta": false,
      "ir": false
    }
  }
}