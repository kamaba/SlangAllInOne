{
  // RDataGalleryWeb - GameTest RDataGallery 的 wasm 浏览器版（web-template 机制）。
  // 层次：
  //   web/RDataHost.sl     - 桌面 QT 宿主的 web 桩（同签名 surface）
  //   ../RDataGallery/RDataGallery.sl - 6 视图工厂（与桌面共用，view0..view5）
  //   web/RDataWeb.sl      - wasm 主循环（单视图全屏 blit + 滚轮/方向键切格）
  // 入口 = RDataGalleryWeb.sp _main_ -> RDataWeb.run()。构建：web/compile.ps1。
  "project": {
    "name": "RDataGalleryWeb",
    "desc": "Std.RData -> RDataChart gallery on the browser wasm VM",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": { "root": "." },
  "dllImports": [],
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "RDataHost.sl", "group": "host", "tag": "host", "ignore": false, "priority": 0 },
      { "path": "../RDataGallery/RDataGallery.sl", "group": "game", "tag": "game", "ignore": false, "priority": 1 },
      { "path": "RDataWeb.sl", "group": "web", "tag": "web", "ignore": false, "priority": 2 }
    ]
  },
  "references": [
    { "path": "../../../../SLangCore/Lib/Core", "name": "Core" },
    { "path": "../../../../SLangCore/Lib/Std", "name": "Std" },
    { "path": "../../../../SLangCore/Lib/Math", "name": "Math" },
    { "path": "../../../../SLangCore/Lib/SLang/SimGameEngine", "name": "SimGameEngine" },
    { "path": "../../../../SLangCore/Lib/SLang/Render/SLangRender", "name": "SLangRender" }
  ],
  "struct": [
    { "class": "RDataHost" },
    { "class": "RDataGallery" },
    { "class": "RDataWeb" }
  ],
  "export": {
    "moduleName": "RDataGalleryWeb",
    "outputDir": "D:\\project\\lang\\SlangAllInOne\\out\\export",
    "versionMain": 0,
    "versionSub": 1,
    "versionPatch": 0,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": false, "token": false, "node": false, "file": false,
      "meta": false, "ir": false
    }
  },
  "global": { "imports": [] },
  "compileFilter": { "isAllGroup": true, "isAllTag": true }
}
