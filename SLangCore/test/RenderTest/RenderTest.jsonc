{
  "project": {
    "name": "RenderTest",
    "desc": "angRender offscreen GL + SLangQT window fill e2e - color-shifting triangle (Phase A pure GL pixel assertions, Phase B QTimer frame loop -> QLabel.setPixmapRgba)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "RenderTest.sl", "group": "render", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "RenderTestHelpers.sl", "group": "render", "tag": "base", "ignore": false, "priority": 1 },
      { "path": "RenderTestCube.sl", "group": "render", "tag": "base", "ignore": false, "priority": 2 },
      { "path": "RenderTestQt.sl", "group": "render", "tag": "base", "ignore": false, "priority": 3 },
      { "path": "RenderTestAudio.sl", "group": "render", "tag": "base", "ignore": false, "priority": 4 },
      { "path": "RenderTestSmoke.sl", "group": "render", "tag": "base", "ignore": false, "priority": 5 },
      { "path": "RenderTestPhasesA.sl", "group": "render", "tag": "base", "ignore": false, "priority": 6 },
      { "path": "RenderTestPhasesB.sl", "group": "render", "tag": "base", "ignore": false, "priority": 7 },
      { "path": "RenderTestPhasesC.sl", "group": "render", "tag": "base", "ignore": false, "priority": 8 },
      { "path": "RenderTestPhasesD.sl", "group": "render", "tag": "base", "ignore": false, "priority": 9 },
      { "path": "RenderTestPhasesE.sl", "group": "render", "tag": "base", "ignore": false, "priority": 10 },
      { "path": "RenderTestPhasesF.sl", "group": "render", "tag": "base", "ignore": false, "priority": 11 },
      { "path": "RenderTestWebUI.sl", "group": "render", "tag": "base", "ignore": false, "priority": 12 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "references": [
    { "path": "./lib/Core.module.slb" },
    { "path": "./lib/Std.module.slb" },
    { "path": "./lib/Math.module.slb" },
    // spm 模式（2026-11-12，§4.9 module 检查机制）：装载前检查工程
    // modules\<名>\ 是否正确（清单 version 与声明一致 + 本地 zip md5 一致），
    // 不正确/未装 → <lang>\modules\<名>.zip（md5 校验）强制重装纠正；
    // zip 缺失走 official 渠道 registry 检索。模块版本取自各模块 jsonc
    // export 段（SLangQT 0.1.0 / SLangRender 1.0.0）。
    { "type": "module", "name": "SLangQT", "channel": "official", "version": "0.1.0" },
    { "type": "module", "name": "SLangRender", "channel": "official", "version": "1.0.0" },
    // SLangAudio 模块（out/export/SLangAudio：module.json + slb +
    // sl_audio_lib.dll；路径引用同 ImageTest 的 SLangImage 模式）：
    // probe / 整段解码（AudioClip）/ 流式（AudioStream）/ 播放（waveOut）
    { "path": "../../../out/export/SLangAudio/SLangAudio.module.json" },
    // SLangWebUI 模块（Phase W WebUI 窗口 + WebGL 帧流；webui_lib.dll 随模块目录）
    { "path": "../../../SLangCore/Lib/SLang/WebUI/export/SLangWebUI/SLangWebUI.module.json" },
    // SLangImage 模块（Phase W 原生 JPEG 编码：libEncodeMem 直通帧指针）
    { "path": "../../../out/export/SLangImage/SLangImage.module.json" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "RenderTest",
    "outputDir": "export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true
  }
}
