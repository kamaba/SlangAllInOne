<Project Sdk="Microsoft.NET.Sdk">

  <!-- ===== 发布形态与默认输出目录（2026-10-18 用户指令，三次定稿）=====
       Debug   : Front（.NET Debug 程序集 + pdb）+ C VM Debug dll（+pdb 侧车）——
                 双端可源码级调试的框架依赖包（目标机需 .NET 8 运行时）；C VM Debug
                 树不编入 JIT（JIT_DESIGN.md §6.1 默认，保持解释器可调试语义）。
                 Debug 包默认附带一份 json 内容：lib\ 下除 *.module.slb 主产物外
                 另打包 *.module.json 调试副本（PackModulesCommand includeJson，
                 配置即默认，无需任何旗标）。
       Release : Native AOT 单文件自包含原生二进制（一体化 slang.exe / linux slang，
                 目标机零 .NET 依赖）；C VM 取 Release 加固树——JIT 已编入且运行期
                 默认开启（CLI 旗标 no-jit / 环境变量 SL_JIT=0 关闭），发布链脚本
                 会显式 pin -DVM_JIT_ENABLE=ON 防 CMake 旧缓存 OFF。
       发布命令零旗标：dotnet publish -c Debug|Release（Release 自动等价
       -p:PublishAot=true，要退回经典托管发布显式传 -p:PublishAot=false）；
       RID 缺省按宿主 OS 补 win-x64 / linux-x64（Native AOT 不支持跨 OS 交叉
       编译，linux 包必须在 WSL/Linux 侧发布）。
       默认输出目录 package\{win32|linux}-{debug|release} 四目录：编译产物（含
       标准库）按 debug/release 分别落对应平台包的 lib\（"win32" = Windows 平台
       包 x64 命名约定，非 32 位；平台 = 目标 RID 优先，无 RID 时按宿主 OS：
       Windows 宿主 → win32-*、WSL/Linux 宿主 → linux-*）。双平台四包同建 =
       Windows 侧 publish 出 win32-* + WSL 侧 publish 出 linux-*（或
       scripts\build-packages.ps1 一键）。显式 -o / -p:PublishDir 恒覆盖。 -->
  <PropertyGroup>
    <_HostIsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</_HostIsWindows>
    <_HostIsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</_HostIsLinux>
    <PublishAot Condition="'$(Configuration)' == 'Release' and '$(PublishAot)' == ''">true</PublishAot>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(PublishAot)' == 'true' and '$(_HostIsWindows)' == 'true'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(PublishAot)' == 'true' and '$(_HostIsLinux)' == 'true'">linux-x64</RuntimeIdentifier>
    <_PackagePlatform Condition="'$(_PackagePlatform)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">linux</_PackagePlatform>
    <_PackagePlatform Condition="'$(_PackagePlatform)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">win32</_PackagePlatform>
    <_PackagePlatform Condition="'$(_PackagePlatform)' == '' and '$(_HostIsWindows)' == 'true'">win32</_PackagePlatform>
    <_PackagePlatform Condition="'$(_PackagePlatform)' == '' and '$(_HostIsLinux)' == 'true'">linux</_PackagePlatform>
    <_PackageConfigName Condition="'$(Configuration)' == 'Debug'">debug</_PackageConfigName>
    <_PackageConfigName Condition="'$(Configuration)' == 'Release'">release</_PackageConfigName>
    <PublishDir Condition="'$(PublishDir)' == '' and '$(_PackagePlatform)' != '' and '$(_PackageConfigName)' != ''">$(MSBuildThisFileDirectory)package\$(_PackagePlatform)-$(_PackageConfigName)\</PublishDir>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SlangAllInOne</RootNamespace>
    <!-- 发布产物名：slang.exe / slang.dll（工程目录与命名空间保持 SlangAllInOne） -->
    <AssemblyName>slang</AssemblyName>
    <!-- Native AOT 发布（-p:PublishAot=true）：PublishAot 默认把 STJ 反射序列化开关
         System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault 置为 false，
         Front 的 SLIR 导出（SLModulePackageWriter.SerializePackage 等全部 json 路径）
         走反射序列化 → 运行期 ReflectionDisabled 异常。Front 已整体 TrimmerRootAssembly
         保形，这里把开关翻回 true（反射序列化经 Delegate.CreateDelegate 装箱访问器
         在 AOT 下可用，性能换兼容；长期正确解 = STJ source-gen，见 md 文档）。 -->
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(PublishAot)' == 'true'">true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Native AOT 会产出 ~50MB 原生 slang.pdb；运行包只运行不发调试（Release 哲学，
         C VM 侧 bin\*.pdb 也已按包卫生排除），且实测 TrimReleasePackage 的 Delete
         成功（exit 0）后 pdb 仍驻留包内（CT 未变、首次执行时 WT 被 touch，复活
         机制未定位）——源头关掉 pdb 生成，一劳永逸。仅 AOT 发布生效，普通构建不受影响。
         2026-10-18 修正：DebugSymbols/DebugType 压不住 ILC 的原生 pdb（零旗标 AOT
         化首跑实测 47.7MB slang.pdb 仍落包），ILC 侧真正的开关是 StripSymbols——
         publish 链不生成/剥离原生符号（与 BINARY_HARDENING 符号卫生策略同向）。 -->
    <DebugSymbols Condition="'$(PublishAot)' == 'true'">false</DebugSymbols>
    <DebugType Condition="'$(PublishAot)' == 'true'">none</DebugType>
    <!-- 2026-10-18 定案（pdb 复活真相）：ILCompiler 包的 _CopyAotSymbols target
         （AfterTargets="Publish"）无条件把 bin\<C>\net8.0\<rid>\native\slang.pdb 复制
         进包，且执行顺序晚于本工程挂在 Publish 后的 Trim/Strip targets——Delete 成功
         后再被复制，即注释记载的"复活"。官方开关 CopyOutputSymbolsToPublishDirectory
         =false 让 _CopyAotSymbols 整体不跑，pdb 从源头不进包（StripSymbols 仅对
         非 Windows 平台生效，win 侧无效，勿再走弯路）。 -->
    <CopyOutputSymbolsToPublishDirectory Condition="'$(PublishAot)' == 'true'">false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="resources\S语言图标-方案B-极简线性.ico" />
  </ItemGroup>

  <!-- 2026-10-18 CLI 三分：new 脚手架的 guide 模板自 Front（Project\Templates\）
       迁入本工程，内嵌资源供 New\NewCommand.cs 读取（slang new project 生成；
       Front 只保留 compile/export）。 -->
  <ItemGroup>
    <None Remove="Templates\ProjectGuideTemplate.md" />
    <EmbeddedResource Include="Templates\ProjectGuideTemplate.md" />
  </ItemGroup>

  <!-- 2026-10-17 仓库重组：编译/测试工程、库源树、工具随迁入本目录后，SDK 的
       默认 **/*.cs glob 会把它们全部吞进宿主工程（多份 Program.cs 类型冲突，
       CS0111）。这里是宿主（Backend/FrontEnd/Pack/Program.cs），其余子树各有
       自己的工程文件，全部排除（对照 SimpleLanguageFront.csproj 对 source\ 的
       排除模式）。 -->
  <ItemGroup>
    <Compile Remove="Project\**" />
    <Compile Remove="tools\**" />
    <Compile Remove="SLangCore\**" />
    <Compile Remove="examples\**" />
    <Compile Remove="md\**" />
    <EmbeddedResource Remove="Project\**" />
    <EmbeddedResource Remove="tools\**" />
    <EmbeddedResource Remove="SLangCore\**" />
    <EmbeddedResource Remove="examples\**" />
    <EmbeddedResource Remove="md\**" />
    <None Remove="Project\**" />
    <None Remove="tools\**" />
    <None Remove="SLangCore\**" />
    <None Remove="examples\**" />
    <None Remove="md\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- FrontEnd: SimpleLanguage compiler (in-process compile) -->
    <ProjectReference Include="..\simple_language\source\SimpleLanguageFront.csproj" />
  </ItemGroup>

  <!-- NETSDK1150 处置（2026-10-18 零旗标 AOT 化的配套）：自包含宿主（Native AOT
       隐含 SelfContained=true）引用框架依赖的 Exe 工程（Front）会被 SDK 拦截
       （ValidateExecutableReferences）。旧发布链靠命令行全局 -r win-x64 让 Front
       同构自包含绕过；csproj 内部属性不传导给 ProjectReference 的设计时求值，
       且强推 Front 走 SC 构建会引入按 RID 的恢复分区问题。此处仅对自动 AOT 场景
       关闭该校验：宿主从不运行 SimpleLanguageFront.exe（其部署件 exe/deps.json/
       runtimeconfig.json 被 TrimReleasePackage 删除），AOT 链接消费的是
       SimpleLanguageFront.dll 的 IL，FDD/SC 构建产物完全一致，关闭无副作用。
       普通 Debug 构建/发布不受影响（条件为假，校验保持默认开启）。 -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- Native AOT 发布支持（2026-10-17，-p:PublishAot=true 时生效）：
       Front 与插件 frontend 是反射重度用户——SLIR 反射 JSON（SLModulePackage 全图）、
       插件 parser/builder 按类型名字符串反射转调（Assembly.GetType/GetMethod/Invoke）、
       SLModulePackageWriter.Build 的 GetMethod/GetProperty、AotStringEnumConverterFactory
       的 Enum.Parse/ToObject。AOT/裁剪器默认按静态可达性裁类型，仅按名字字符串反射的
       类型会被裁掉（运行期 MissingMetadataException / 插件 GetType 返回 null）。
       把三个程序集整体置为裁剪根：类型+成员+嵌入资源全保形（代价：exe 变大）。
       普通（非 AOT）publish 不受影响。
       2026-10-19 增补（宿主自身 slang 也置根）：LSP 链路 LspServer.WriteRaw/Respond/
       Notify 与 LspCompileCommand 的 payload 全是匿名类型经 JsonSerializer.Serialize(object)
       反射序列化——匿名类型属性 getter 无静态引用点，不置根会被裁空 → AOT 实测 stdout
       仅 "{}"（initialize 无 capabilities、lsp-compile 无 diagnostics，2026-10-19 取证）；
       置根后经 Delegate.CreateDelegate 装箱访问器恢复（同上 2026-10-17 结论）。 -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="SimpleLanguageFront" />
    <TrimmerRootAssembly Include="SLCSharpMonoFrontend" />
    <TrimmerRootAssembly Include="SLJavaHotspotFrontend" />
    <TrimmerRootAssembly Include="slang" />
  </ItemGroup>

  <ItemGroup>
    <None Update="resources\S语言图标-方案B-极简线性.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- C VM config that feeds the packaged runtime: follows the publish
       configuration (-c Debug / -c Release); override with -p:CvmBuildConfig. -->
  <PropertyGroup>
    <CvmBuildConfig Condition="'$(CvmBuildConfig)' == '' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Release')">$(Configuration)</CvmBuildConfig>
    <CvmBuildConfig Condition="'$(CvmBuildConfig)' == ''">Release</CvmBuildConfig>
    <CvmBinDir>$(MSBuildThisFileDirectory)..\csimple_lang\build\$(CvmBuildConfig)\bin</CvmBinDir>
    <ApplicationIcon>resources\S语言图标-方案B-极简线性.ico</ApplicationIcon>
    <PackageId>simple_language.kamaba233.dingo.com</PackageId>
    <Authors>kamaba233</Authors>
    <PackageIcon>S语言图标-方案B-极简线性.png</PackageIcon>
  </PropertyGroup>

  <!-- Publish is self-contained: build the C VM tree (incremental Ninja build,
       a no-op when unchanged) and pack the runtime next to the app under bin\
       so the output depends only on its own directory.
       CvmBackend.Locate prefers <app dir>\bin\ over the dev build trees.
       2026-10-18 门控升级：三个 Windows 专属 pack target 只在「宿主是 Windows
       且目标不是 linux RID」时运行——build-vm-win.ps1 是 PowerShell，且
       pack-modules/pack-docs 要执行刚发布的 slang.exe（Windows PE）。linux 包
       （在 WSL/Linux 侧 dotnet publish，或跨发 -r linux-x64）由脚本负责组装
       bin\(.so) / module\ / md\（scripts\build-packages.ps1 与 release-slang.ps1，
       module\ + md\ 平台无关直接复用 Windows 包产物）。
       手动逃逸：-p:SkipCvmPack=true。 -->
  <Target Name="PackCvmRuntime" AfterTargets="Publish" Condition="'$(SkipCvmPack)' != 'true' and '$(_HostIsWindows)' == 'true' and !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">
    <!-- BINARY_HARDENING.md: Release packages carry the hardened VM
         (SLVM_HARDEN=ON startup anti-debug); Debug packages stay debuggable. -->
    <PropertyGroup>
      <CvmHardenFlag Condition="'$(CvmBuildConfig)' == 'Release'">-Harden</CvmHardenFlag>
    </PropertyGroup>
    <!-- 2026-10-18 修复：scripts 自工作区根迁入 SlangAllInOne\scripts\ 后，此处的
         ..\scripts\build-vm-win.ps1 旧路径失效（classic publish 自迁移后一直未被
         触发，首次重跑即暴露）——改为工程内 scripts\ 相对路径。 -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\build-vm-win.ps1&quot; -Config $(CvmBuildConfig) $(CvmHardenFlag)" />
    <ItemGroup>
      <CvmRuntimeFiles Include="$(CvmBinDir)\csimple_lang_dll.dll" />
      <CvmRuntimeFiles Include="$(CvmBinDir)\sqlite3.dll" />
      <!-- Debug-symbol sidecar so the packaged C VM can be debugged
           (attach to slang.exe and break in csimple_lang sources;
           the PDB source paths match this repo checkout). -->
      <CvmRuntimeFiles Include="$(CvmBinDir)\csimple_lang_dll.pdb" Condition="Exists('$(CvmBinDir)\csimple_lang_dll.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(CvmRuntimeFiles)" DestinationFolder="$(PublishDir)bin\" SkipUnchangedFiles="true" />
  </Target>

  <!-- Official release packaging: compile the standard library modules
       (Core → Std → Math; R15: format binary+json = SLB
       main + json debug copy) and pack them flat under <package>\lib\
       (one directory, no per-module sub-trees). The deep relative paths
       embedded in the modules (moduleReferences "../Core", FFI dllImports
       "../../out/export/Math/math_lib.dll") resolve through the C VM
       loader fallbacks: references retry <dir>\<basename>.module.json
       (json OR slb, SLB-preferred) and FFI retries <pkg_dir>\<basename>.
       Debug package keeps .module.slb + .module.json; Release keeps only
       the mandatory .slb (+ math_lib.dll).
       The whole build recipe lives in the app itself
       (Pack/PackModulesCommand.cs) and runs here through the just-published
       exe: one clean child process per module, same model as the stdlib
       driver (Project\CompileStdlib). A non-zero exit fails the publish
       (never ship a broken package). -->
  <Target Name="PackStdModules" AfterTargets="PackCvmRuntime" Condition="'$(SkipCvmPack)' != 'true' and '$(_HostIsWindows)' == 'true' and !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">
    <Exec Command="&quot;$(PublishDir)$(AssemblyName).exe&quot; pack-modules --config $(CvmBuildConfig)" />
  </Target>

  <!-- Official release packaging: copy the user-facing FrontEnd markdown docs
       (md root entry docs + syntax/lib/project/log/plugins mirrors + per-library
       notes under source\Front\Lib) into <package>\md\. Internal trees (md\ai\,
       md\vm\) and cvm_* C-side project docs are excluded. Recipe lives in
       Pack/PackDocsCommand.cs and runs here through the just-published exe,
       same self-bootstrap model as pack-modules. -->
  <Target Name="PackDocs" AfterTargets="PackStdModules" Condition="'$(SkipCvmPack)' != 'true' and '$(_HostIsWindows)' == 'true' and !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">
    <Exec Command="&quot;$(PublishDir)$(AssemblyName).exe&quot; pack-docs" />
  </Target>

  <!-- 2026-10-18 目录方案（用户指令，设计记录 md/project/package-layout.md）：
       包根的插件 frontend 程序集（SLCSharpMonoFrontend / SLJavaHotspotFrontend
       + pdb——Front 工程 ProjectReference 的发布伴生物）移入 <package>\plugins\。
       plugins\ = 插件内容目录（区别于普通包：插件带 plugin.jsonc/cvm/frontend/
       slang 多层结构与 @tag{} 能力点，故独立于未来的 modules\ 包目录）；
       Front 侧 PluginFrontendParser.FindPluginsParent 已增加 <exe>\plugins\
       探测，插件管理器把整插件目录装进 plugins\<id>\ 后即可被 @tag 路由。
       Native AOT（Release）发布不产出这些托管 dll，列表为空即静默跳过。 -->
  <Target Name="RelocatePluginFrontends" AfterTargets="Publish">
    <ItemGroup>
      <PluginFrontendFiles Include="$(PublishDir)SLCSharpMonoFrontend.*" />
      <PluginFrontendFiles Include="$(PublishDir)SLJavaHotspotFrontend.*" />
    </ItemGroup>
    <Move SourceFiles="@(PluginFrontendFiles)" DestinationFolder="$(PublishDir)plugins\" Condition="'@(PluginFrontendFiles)' != ''" />
  </Target>

  <!-- 2026-10-18 用户指令：licenses\ 不再随包导出（原 PackThirdPartyLicenses
       target 已删）。第三方协议文本真源保留在仓库
       ..\csimple_lang\third_party\LICENSES\（NOTICE.md + 各组件协议全文），
       需要合规材料时从仓库获取。 -->

  <!-- Release-package hygiene (part 1/2, BEFORE the publish copy): dotnet
       publish never cleans the output directory, so stale files from older
       publishes (old host/frontend assemblies, test scratch dirs, runtime
       build\logs) would accumulate forever. Wipe the whole package directory
       first so the result contains ONLY what the current publish produces.
       NOTE: must hook the publish-copy entry, NOT Publish — a
       BeforeTargets="Publish" hook runs AFTER Publish's dependency chain
       (which already copied the files), so it would delete the fresh output
       and the pack targets would then find no slang.exe (MSB3073/9009).
       🔥 2026-10-18 复盘（本机 dotnet 10.0.401 实测死链）：SDK 9/10 重构了发布
       拷贝链——CopyFilesToPublishDirectory 的依赖改为
       _IncrementalCleanPublishDirectory + _CopyResolvedFilesToPublish*，
       _CopyFilesToPublishFolder 只剩 ClickOnce(PublishOnly) 路径引用；继续挂
       它 = wipe 静默不触发（实证：win32-release 里 19MB MathTest 测试残留跨
       多次发布存活）。改为双入口：_IncrementalCleanPublishDirectory（新链，
       拷贝阶段最先跑，语义与旧挂点等价）+ _CopyFilesToPublishFolder（SDK 8
       兜底；目标不存在/不跑时挂点自然落空，无害）。_WipeReleasePackageDone
       守卫防极端管线下双入口先后触发时第二次 wipe 误删已拷入的新产物。
       Guarded by "the PublishDir lies under a package folder" so an
       accidental "publish -o <precious dir>" cannot wipe anything unrelated. -->
  <Target Name="WipeReleasePackage" BeforeTargets="_IncrementalCleanPublishDirectory;_CopyFilesToPublishFolder" Condition="'$(Configuration)' == 'Release' and '$(_WipeReleasePackageDone)' != 'true' and $([System.String]::Copy('$(PublishDir)').Contains('package'))">
    <RemoveDir Directories="$(PublishDir)" Condition="Exists('$(PublishDir)')" />
    <MakeDir Directories="$(PublishDir)" />
    <PropertyGroup>
      <_WipeReleasePackageDone>true</_WipeReleasePackageDone>
    </PropertyGroup>
  </Target>

  <!-- Release-package hygiene (part 2/2, AFTER all pack targets): the runtime
       package keeps only what is needed at run time.
         - SimpleLanguageFront.exe: the Front CLI apphost of a referenced Exe
           project. The host compiles in-process through SimpleLanguageFront.dll
           (and pack-modules bootstraps via this app's own exe), so the CLI
           host is dead weight in the package. The .dll itself stays (needed).
         - SimpleLanguageFront.deps.json / .runtimeconfig.json: same story as
           the exe — dependency resolution and TFM binding run against the
           host's own slang.deps.json / slang.runtimeconfig.json.
         - *.pdb in the package root: no debugging value in the runtime
           package (plugin frontend pdbs, referenced project pdbs). The C VM
           sidecar pdb under bin\ is handled by PackCvmRuntime's Exists()
           condition and is not packed for Release builds.
       Plugin frontend dlls (SLCSharpMonoFrontend/SLJavaHotspotFrontend):
       2026-10-18 起 RelocatePluginFrontends target 把它们移入 <package>\
       plugins\（插件内容目录）；Native AOT（Release 默认形态）发布本身不
       产出这些托管 dll，仅在经典托管 Release 发布（-p:PublishAot=false）
       时经该 target 归位。 -->
  <Target Name="TrimReleasePackage" AfterTargets="PackDocs" Condition="'$(Configuration)' == 'Release'">
    <!-- 相对 PublishDir 加固（2026-10-17）：dotnet publish -o 传入的已是绝对路径；
         但经 msbuild -p:PublishDir=<相对> 直跑本 target 时，SDK 按工程目录规范化
         （实测 → SlangAllInOne\SlangAllInOne\... 双层错位，glob 落空、清理静默失效）。
         先绝对化再取通配，两种入口下 Delete 都指对地方。 -->
    <PropertyGroup>
      <PublishDirAbsolute>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</PublishDirAbsolute>
    </PropertyGroup>
    <ItemGroup>
      <ReleaseJunk Include="$(PublishDirAbsolute)SimpleLanguageFront.exe" />
      <!-- Linux apphost 无 .exe 后缀（裸名 SimpleLanguageFront）——release-slang.ps1
           v0.0.3 的 linux 包曾带过它（无害但臃肿的死重）。Windows 下此裸名不存在，
           Delete 静默跳过，两侧共用一条。 -->
      <ReleaseJunk Include="$(PublishDirAbsolute)SimpleLanguageFront" />
      <ReleaseJunk Include="$(PublishDirAbsolute)SimpleLanguageFront.deps.json" />
      <ReleaseJunk Include="$(PublishDirAbsolute)SimpleLanguageFront.runtimeconfig.json" />
      <ReleaseJunk Include="$(PublishDirAbsolute)*.pdb" />
      <!-- BINARY_HARDENING.md P0: binary-artifact blacklist under bin\ (defense
           in depth - PackCvmRuntime only copies the two runtime dlls, but any
           future copy pattern must not leak symbol/linker artifacts). -->
      <ReleaseJunk Include="$(PublishDirAbsolute)bin\*.map" />
      <ReleaseJunk Include="$(PublishDirAbsolute)bin\*.pdb" />
      <ReleaseJunk Include="$(PublishDirAbsolute)bin\*.exp" />
      <ReleaseJunk Include="$(PublishDirAbsolute)bin\*.ilk" />
      <ReleaseJunk Include="$(PublishDirAbsolute)bin\*.lib" />
      <!-- RelocatePluginFrontends 把插件 pdb 也移进 plugins\（经典托管
           Release 发布时存在）——运行包同样不带走。 -->
      <ReleaseJunk Include="$(PublishDirAbsolute)plugins\*.pdb" />
    </ItemGroup>
    <Delete Files="@(ReleaseJunk)" />
  </Target>

</Project>
