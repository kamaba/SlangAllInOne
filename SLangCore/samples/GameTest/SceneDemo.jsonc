{
  // SceneDemo — gameExample/Test（doc/19）：SceneManager 按路径加载三个场景，
  // 场景里挂脚本由 Application 帧循环驱动；S 键经 SceneExporter 导出 JSON。
  // 构建：slang compile SceneDemo.jsonc --format binary+json
  // 运行：slang run out/export/SceneDemo/SceneDemo.module.slb
  "project": {
    "name": "SceneDemo",
    "desc": "Unity-style scene management demo: load scene json by path, mount scripts, run scene logic, export scene json",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": { "root": "." },
  "dllImports": [],
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "QTHost.sl", "group": "game", "tag": "game", "ignore": false, "priority": 0 },
      { "path": "SceneScripts.sl", "group": "game", "tag": "game", "ignore": false, "priority": 1 },
      { "path": "SceneSmokeTest.sl", "group": "game", "tag": "game", "ignore": false, "priority": 2 },
      { "path": "SceneDemo.sl", "group": "game", "tag": "game", "ignore": false, "priority": 3 },
      { "path": "SceneDemoWebUI.sl", "group": "game", "tag": "game", "ignore": false, "priority": 4 }
    ]
  },
  "references": [
    { "path": "../../../../../SLangCore/Lib/Core", "name": "Core" },
    { "path": "../../../../../SLangCore/Lib/Std", "name": "Std" },
    { "path": "../../../../../SLangCore/Lib/Math", "name": "Math" },
    { "path": "D:/project/lang/SlangAllInOne/out/export/SimGameEngine/SimGameEngine.module.slb", "name": "SimGameEngine" },
    { "path": "D:/project/lang/SlangAllInOne/out/export/SLangRender/SLangRender.module.slb", "name": "SLangRender" },
    { "path": "D:/project/lang/SlangAllInOne/out/export/SLangQT/SLangQT.module.json", "name": "SLangQT" },
    { "path": "D:/project/lang/SlangAllInOne/SLangCore/Lib/SLang/WebUI/export/SLangWebUI/SLangWebUI.module.json", "name": "SLangWebUI" },
    { "path": "D:/project/lang/SlangAllInOne/out/export/SLangImage/SLangImage.module.json", "name": "SLangImage" }
  ],
  "struct": [
    { "class": "QTHost" },
    { "class": "SphereMeshScript" },
    { "class": "ShapeMeshScript" },
    { "class": "SpinScript" },
    { "class": "ProbeScript" },
    { "class": "SceneScriptFactories" },
    { "class": "SceneSmokeTest" },
    { "class": "SceneDemo" },
    { "class": "SceneDemoWebUI" }
  ],
  "export": {
    "moduleName": "SceneDemo",
    "outputDir": "D:\\project\\lang\\SlangAllInOne\\out\\export",
    "versionMain": 0,
    "versionSub": 1,
    "versionPatch": 0,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": false,
      "token": false,
      "node": false,
      "file": false,
      "meta": false,
      "ir": false
    }
  },
  "publish": {
    "mode": "both",
    "gui": true,
    "outputDir": "publish",
    "config": "Release"
  },
  "qtRuntime": {
    "enabled": true,
    "qt6Dir": "C:\\Qt\\6.8.1\\msvc2022_64",
    "debugRuntime": false,
    "targetDir": "lib/windows",
    "modules": [
      "Network", "Sql", "Svg", "SvgWidgets", "OpenGL", "OpenGLWidgets",
      "PrintSupport", "Xml", "Concurrent", "Test", "UiTools", "Help",
      "DBus", "Designer"
    ],
    "plugins": {
      "platforms": ["qwindows", "qoffscreen", "qminimal"],
      "styles": ["qmodernwindowsstyle"],
      "imageformats": ["qgif", "qico", "qjpeg", "qsvg"],
      "iconengines": ["qsvgicon"],
      "sqldrivers": ["qsqlite"],
      "tls": ["qschannelbackend", "qcertonlybackend"],
      "networkinformation": ["qnetworklistmanager"],
      "generic": ["qtuiotouchplugin"]
    },
    "extraBinDlls": ["opengl32sw.dll"]
  },
  "global": { "imports": [] },
  "compileFilter": { "isAllGroup": true, "isAllTag": true }
}
