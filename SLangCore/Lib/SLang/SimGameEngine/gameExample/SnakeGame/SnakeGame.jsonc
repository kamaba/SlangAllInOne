{
  // SnakeGame —— 贪吃蛇示例（gameExample 首个工程，2026-11-17）
  // QT 窗口（SLangQT）+ SimGameEngine 渲染上屏（renderFrame RGBA8 →
  // QLabel.setPixmapRgba）+ 引擎 InputSystem（QT 键盘回调 → C 状态表）。
  // 蛇逻辑/渲染顶点为胶水（每帧重建 3 组烘焙顶点，O(格数) 小计算）；
  // 投影数学在 C（sle_ortho_bake，正交烘焙路径 = SimSystemsTest S10 同款）。
  // 构建/运行：
  //   1) 引擎：slang compile SLangCore\Lib\SLang\SimGameEngine\SimGameEngine.jsonc --format binary
  //   2) QT：  powershell -File SLangCore\Lib\SLang\QT\cvm\build-slqt.ps1 -Qt
  //            （-DeployQt gui 额外部署 Qt6 运行时到模块槽位）
  //   3) 游戏：slang compile SLangCore\Lib\SLang\SimGameEngine\gameExample\SnakeGame\SnakeGame.jsonc --format binary
  //   4) 运行：slang run out\export\SnakeGame\SnakeGame.module.slb
  //      （方向键控制，R 重开）
  //
  // ⚠ 2026-11-18 排障结论（「发布不了 / 运行调试秒退 0xC0000409」根因）：
  //   发布链路本身没问题（slang publish SnakeGame.sp EXIT=0，发布包 exe 实测
  //   正常）。真凶 = out\export\SnakeGame\slang_qt.dll 是**陈旧构建**（哈希 !=
  //   out\export\SLangQT\slang_qt.dll）：FFI 预载到旧 dll 后运行秒退（qwindows）
  //   或崩 0xC0000409（offscreen）。自愈 = run-dev.ps1（每次运行前按哈希比对
  //   export 槽位自动刷新）；手工修法 = 把 export 槽位的 slang_qt.dll 覆盖到
  //   out\export\SnakeGame。运行调试用：powershell -File run-dev.ps1 [-Offscreen|-Debug]。
  "project": {
    "name": "SnakeGame",
    "desc": "Snake game example on SimGameEngine + SLangQT (QT window, engine ortho bake render path, InputSystem)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "dllImports": [],
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      // QTHost.sl 独立解析（import 平面仅 SLangQT）承接 QT 对象，规避
      // SimGameEngine（传递 SLangRender 的 SLang namespace）与 SLangQT 的
      // import 平面「SLang」重名冲突（MetaCoreMemberNameImportConflict）
      { "path": "QTHost.sl", "group": "game", "tag": "game", "ignore": false, "priority": 0 },
      { "path": "SnakeGame.sl", "group": "game", "tag": "game", "ignore": false, "priority": 1 },
      // SnakeSfx.sl 独立解析（import 平面仅 SLangAudio），音效一次性播放 +
      // 资源目录探测；wav 资源由 make-sfx.ps1 生成到 sfx\
      { "path": "SnakeSfx.sl", "group": "game", "tag": "game", "ignore": false, "priority": 2 },
      // SnakeFairy.sl：FairyGUI 界面层（菜单/HUD/排行榜；依赖引擎 ui/ 动态
      // quad API + QTHost 鼠标门面；fairyui\ 资源由 make-fairyui.ps1 生成）
      { "path": "SnakeFairy.sl", "group": "game", "tag": "game", "ignore": false, "priority": 3 },
      // SceneInspector.sl：场景层级检视器（Ctrl+F12；QTreeWidget 路径树 +
      // QTextEdit 详情，选择轮询式；QT 操作全经 QTHost 包装）
      { "path": "SceneInspector.sl", "group": "game", "tag": "game", "ignore": false, "priority": 4 },
      // Go3DDemo.sl：GoWrapper 等价演示（CPU 软渲染旋转立方体 → go3d
      // 元素纹理原位更新；绑定时引用 pkg/RenderTexture/Mathf）
      { "path": "Go3DDemo.sl", "group": "game", "tag": "game", "ignore": false, "priority": 5 }
    ]
  },
  "references": [
    // 形态照抄 Test.jsonc：Lib 包相对 jsonc 目录（上 5 级到根）、模块产物绝对路径
    // （SnakeGame → gameExample → SimGameEngine → SLang → SLangCore → SlangAllInOne）
    { "path": "../../../../../SLangCore/Lib/Core", "name": "Core" },
    { "path": "../../../../../SLangCore/Lib/Std", "name": "Std" },
    { "path": "../../../../../SLangCore/Lib/Math", "name": "Math" },
    { "path": "D:/project/lang/SlangAllInOne/out/export/SimGameEngine/SimGameEngine.module.slb", "name": "SimGameEngine" },
    // SLangRender 是 SimGameEngine 的传递依赖（RenderSystem -> RenderPipeline），
    // 必须直接列出：publish 只扫描「直接引用模块」导出目录里的原生库，
    // 不沿传递依赖收集。缺这条 -> 发布包 lib\windows 没有 sl_render_lib.dll，
    // 运行期渲染 FFI 静默失败、pixels 全 0 -> QLabel 白窗口。
    { "path": "D:/project/lang/SlangAllInOne/out/export/SLangRender/SLangRender.module.slb", "name": "SLangRender" },
    // SLangAudio 直接引用（SnakeSfx 消费 namespace Audio）：除跨模块静态
    // 形态约束外，publish 只按「直接引用模块」导出目录收集原生库 ——
    // 缺这条发布包 lib\windows 没有 sl_audio_lib.dll，音效静默失效
    { "path": "D:/project/lang/SlangAllInOne/out/export/SLangAudio/SLangAudio.module.slb", "name": "SLangAudio" },
    { "path": "D:/project/lang/SlangAllInOne/out/export/SLangQT/SLangQT.module.json", "name": "SLangQT" }
  ],
  "struct": [
    // 类为根级（源文件无 namespace 块——jsonc namespace 包装会导致方法不注册）
    { "class": "SnakeGame" },
    { "class": "QTHost" },
    { "class": "SnakeSfx" },
    { "class": "SnakeFairy" },
    { "class": "SceneInspector" },
    { "class": "Go3DDemo" }
  ],
  "export": {
    "moduleName": "SnakeGame",
    "outputDir": "D:\\project\\lang\\SlangAllInOne\\out\\export",
    "versionMain": 0,
    "versionSub": 1,
    "versionPatch": 0,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": false,
      "token": false,
      "node": false,
      "file": false,
      "meta": false,
      "ir": false
    }
  },
  // 发布配置（VSCode 右键「发布工程」= slang publish <sp>，走这里的默认段）：
  // 无此段时 mode=both/config=Release/gui=false，且不带任何 Qt 运行库 →
  // 打包出来只有 Core/Gui/Widgets 三个 Qt dll，真窗口崩在 ffi_appCreate
  // （0xC0000409）。gui=true 去掉 cmd 黑窗，与真窗口程序匹配。
  "publish": {
    "mode": "both",
    "gui": true,
    "outputDir": "publish",
    "config": "Release"
  },
  // Qt 运行库随包部署（QTTest/RenderTest 同款机制）：slang_qt.dll 在
  // publish\release\lib\windows，故 targetDir=lib/windows 与其同位；
  // Plugins 重定向 + qt.conf 由 PublishCommand 自动写。缺件按 FAIL 处理，
  // 保证 VSCode 打包产物开箱即跑（无需手工 deploy-qt.ps1）。
  "qtRuntime": {
    "enabled": true,
    "qt6Dir": "C:\\Qt\\6.8.1\\msvc2022_64",
    "debugRuntime": false,
    "targetDir": "lib/windows",
    "modules": [
      "Network", "Sql", "Svg", "SvgWidgets", "OpenGL", "OpenGLWidgets",
      "PrintSupport", "Xml", "Concurrent", "Test", "UiTools", "Help",
      "DBus", "Designer"
    ],
    "plugins": {
      "platforms": ["qwindows", "qoffscreen", "qminimal"],
      "styles": ["qmodernwindowsstyle"],
      "imageformats": ["qgif", "qico", "qjpeg", "qsvg"],
      "iconengines": ["qsvgicon"],
      "sqldrivers": ["qsqlite"],
      "tls": ["qschannelbackend", "qcertonlybackend"],
      "networkinformation": ["qnetworklistmanager"],
      "generic": ["qtuiotouchplugin"]
    },
    "extraBinDlls": ["opengl32sw.dll"]
  },
  "global": {
    "imports": []
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  }
}
