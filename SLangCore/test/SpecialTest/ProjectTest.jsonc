{
  "project":
  {
    "name": "SpecialTest",
    "desc": "Special test tests - AOT native compile (merged from AOTTest), C#/Java/JS interop",  
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "AOTTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "AOTStructTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "AOTGPUTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "FFITest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "CSharpTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "CSharpTest2.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "CSharpTest3.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "JavaTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "JavaTest2.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "JsQuickjsTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "CPlusClangTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "MasmX64Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "PythonTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "PhpTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "TypeScriptNodeV8Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "GoTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ProcessTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "AOT.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "MapTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "FileTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "CsvTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "DirectoryTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "ConsoleTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "DateTimeTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "LinkedListTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "Sqlite3Test.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "ModuleGlobalTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console",
      "Std.IO.File"
    ],
    "replace": {
      "DEBUG": "true"
    },
    "data": {
      "var1": 12,
      "arrvar1": [1, 2, 3, 4, 5],
      "vardata2": {
        "a": 10,
        "b": 20.1
      }
    }
  },
  // 插件声明（PLUGIN_SYSTEM_DESIGN.md §0.1/§4.2）：key=插件 id；lib 对象由
  // PluginManager（PluginLib 导出段）平台目录回退（package/windows/（2026-10-25
  // 标准，dir 缺省 package）→ package/windows-x64/ → …）求值平台库并递归拷到
  // out/export/ProjectTest/plugin/echo/windows/，module.json 记
  // 相对包路径（lib/libs）；CVM 侧登记不加载（惰性激活）。
  "plugins": {
    "echo": {
      "name": "echo_test_plugin",
      "version": "0.1.0",
      "path": "plugin/echo",
      "enabled": true,
      "abi": 1,
      "lib": { "dir": "package", "select": "auto" },
      // 插件级平台条件短写（§4.1/§4.3：复用 SLRequirementExpr 语法，String=eq 简写）：
      // 编译为条件 AST 随 module.json 导出，CVM 装配期 sl_require_check 求值
      //（先模块后插件），未通过按 onUnavailable 三态降级（disable/warn/error）。
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "systemCall", "name": "echo" }
      ]
    },
    // csharp_mono（P1-e，MONO_INTEGRATION_DESIGN.md §4.3 / PLUGIN_SYSTEM_DESIGN.md §10.1）：
    // lib 用字符串直给（相对包路径，CVM 侧基准 = module.json 所在目录拼
    // sl_plugin_resolver_join_lib_path），从 plugin 原位加载——不走
    // PluginManager（PluginLib 导出段）拷贝（避免每趟导出复制 mono BCL
    // 深层子树）；原位同目录天然齐备 mono-2.0-sgen.dll + BCL。2026-10-25
    // 插件包布局标准：三工程产物统一导出 plugin\csharp_mono\package\（原生库
    // package\windows\，.slb 平铺 package\ 根）。
    // prefix 必须显式 = 实际符号前缀 "sl_csharp_mono_"（plugin.jsonc entry.prefix），
    // 缺省 id+"_" 会解析不到六件套符号。测试程序集 SLCSharpTestLib.dll 部署在
    // 插件 dll 同目录，asm 元参用裸文件名经 assemblies_path 兜底命中。
    "csharp_mono": {
      "name": "csharp_runtime_use_mono_engine",
      "version": "0.1.0",
      "path": "plugin/csharp_mono",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_csharp_mono_",
      "lib": "../../../../plugin/csharp_mono/package/windows/cvm_csharp_mono.dll",
      // 额外引用（references）：块内 C# 引用的预编译 managed 程序集——
      // 导出期 Front 拷入插件 libDir（编译期 csc /r: 引用 + 运行期 mono
      // assemblies_path 从插件 dll 同目录裸名解析）+ 随 Build 请求下发路径。
      // 相对路径按本 jsonc 所在目录解析（同 lib/path 口径）。
      // 注意：System.Windows.Forms / System.Drawing 不能加进来——csc 默认
      // csc.rsp 已引用 Framework 同名程序集（同标识 4.0.0.0），显式 /r: mono
      // 版会 CS1703 重复导入；编译期用 csc.rsp 默认引用，运行期 mono 经
      // assemblies_path 从插件 BCL 树（lib/mono/4.5/，已补齐 mono 6.12.0.206
      // 的 SWF/Drawing 等）解析加载，见 CSharpTest3.sl。
      "references": [ "CsExtra/ExtraMathLib.dll" ],
      // 额外源码（sources）：与全部 @csharp_mono(){} 块体同批合并编译进
      // SLAtSign.dll 的 .cs 文件——导出期 Front 读文件内容随 Build 请求
      // 下发，块内头区 using 其命名空间即可调用其中类型（无需重编 dll）。
      // CsExtra\SlExtraUtil.cs = 原有示例；CsharpCode\SlCSharpCodeUtil.cs =
      // Code 目录规范位（本工程四语言外部源对齐：CsharpCode/JavaCode/
      // COrCplusCode/JsCode）。
      "sources": [ "CsExtra/SlExtraUtil.cs", "CsharpCode/SlCSharpCodeUtil.cs" ],
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "systemCall", "name": "csharp" }
      ]
    },
    // java_hotspot（HOTSPOT_JNI_INTEGRATION_DESIGN.md）：lib 用字符串直给原位
    // 相对路径（同 csharp_mono 口径，不走 PluginManager PluginLib 导出段拷贝）——
    // 插件 dll 同目录树天然齐备 ..\..\runtime\jvm.dll 与 SLAtSign.jar（C 侧
    // SLJH_JVM_RELATIVE/SLJH_JAR_RELATIVE 相对插件 dll 定位；2026-10-25 起同在
    // plugin\java_hotspot\package\windows\）。prefix 必须显式
    // = "sl_java_hotspot_"（plugin.jsonc entry.prefix）。块体 .java 源码由
    // SLLabelBuilder 经 javac --release 17 编译部署到 <libDir>\classes\，
    // 运行期 bridge 以 SLAtSign 组前缀 + 裸类名 loadClass。本机无 JDK 时
    // Build 返回 notFound/kind=notFound 降级（onUnavailable=warn 不阻断）。
    "java_hotspot": {
      "name": "java_runtime_use_hotspot_engine",
      "version": "0.1.0",
      "path": "plugin/java_hotspot",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_java_hotspot_",
      "lib": "../../../../plugin/java_hotspot/package/windows/cvm_java_hotspot.dll",
      // 额外源码（sources）：与全部 @java_hotspot(){} 块体条目同批 javac
      // 合并编译（对位 csharp_mono 的 sources 语义）——外部 .java 声明
      // package SLAtSign 与块体生成类同包直调（包私有类不要求与 Front
      // 分配的部署文件名 CsSrc_名 同名），class 部署进插件 classes\
      // SLAtSign\ 包目录（URLClassLoader 同一加载域）。见 JavaTest.sl 的
      // testExternalSource。
      "sources": [ "JavaCode/SlJvExtraUtil.java" ],
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "signLabel", "name": "signLabel" }
      ]
    },
    // javascript_quickjs（QUICKJS_INTEGRATION_DESIGN.md）：vendored QuickJS
    // 引擎编入插件 dll（无外部运行时依赖）。lib 字符串直给原位相对路径
    //（同 csharp_mono/java_hotspot 口径）；prefix 必须显式
    // = "sl_javascript_quickjs_"（plugin.jsonc entry.prefix）。块体经
    // frontend（SLPF v3）在 Front 导出期部署为 <libDir>\scripts\
    // Entry_N.js（"use strict" + function run 包裹源，编译期 QuickJS
    // compile-only 语法检查）；运行期 quickjs_bridge JS_Eval + JS_Call。
    // sources（额外 JS 库）：Front 读文件内容随 Build 请求下发，部署为
    // scripts\CsSrc_SlJsExtraUtil.js + 清单 _slqjs_libs.txt——运行期首次
    // 执行该 lib 的块前按清单序求值进对应 JSContext（每库仅一次），块内
    // 直接调用其中全局函数（见 JsQuickjsTest.sl）。通道原语 refModule
    //（SLang.Plugin.JavaScriptQuickjs）经插件自身 plugin.jsonc 的
    // refModule 段自动加载。
    "javascript_quickjs": {
      "name": "javascript_runtime_use_quickjs_engine",
      "version": "0.1.0",
      "path": "plugin/javascript_quickjs",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_javascript_quickjs_",
      "lib": "../../../../plugin/javascript_quickjs/package/windows/cvm_javascript_quickjs.dll",
      "sources": [ "JsCode/SlJsExtraUtil.js" ],
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "signLabel", "name": "signLabel" }
      ]
    },
    // cplus_clang：块体经 frontend（自带 clang++ 工具链优先 → SL_CLANGPP/
    // PATH 外部 clang++，无 cl 回退）在 Front 导出期合并编译成原生
    // SLCpp.dll 部署插件 dll 同目录；labelExec 走「关联依赖预装载 +
    // 装载 + 固定原型派发」（cvm_cplus_clang.c 双平台：LoadLibrary/
    // dlopen + GetProcAddress/dlsym("<entry>_main"；装载目标库前按
    // SLCpp.dll.deps 伴随清单预装载关联 dll/so，SLCppValue 布局镜像
    // 零转换）。差异点：块内 SLCPP_EXPORT 函数入口是
    // extern "C" 导出，SL 侧经既有 FFI 机制（@DllImport 装配期 73→77 改写 +
    // 伴生契约 SLCpp.dll.slffi.json 编译期签名校验 LID 21483/21484/21485）
    // 直接按签名映射调用，不经 labelExec 通道。prefix 必须显式
    // = "sl_cplus_clang_"（plugin.jsonc entry.prefix）。块编译产物
    // SLCpp.dll 运行中进程占用时重编译会 deployFailed（先退出宿主再编）。
    // references（第三方关联引入，同 csharp_mono 口径：导出期 Front 平拷
    // 入插件 libDir（package/windows）并随 Build 请求下发绝对路径）：
    // .h → 所在目录追加 -I；.lib/.a/.o/.obj → 追加链接输入（构建期
    // clang++ 消费）；.dll/.so → 写 SLCpp.dll.deps 伴随清单（运行期
    // cvm 装载前预装载，与 SLCpp.dll 同位命中）。相对路径按本 jsonc
    // 所在目录解析（同 lib/path 口径）。
    "cplus_clang": {
      "name": "cplus_runtime_clang_engine",
      "version": "0.1.0",
      "path": "plugin/cplus_clang",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_cplus_clang_",
      "lib": "../../../../plugin/cplus_clang/package/windows/cvm_cplus_clang.dll",
      "references": [
        "../../../Project/CLangdll/CLangdll.h",
        "../../../x64/Debug/CLangdll.lib",
        "../../../x64/Debug/CLangdll.dll"
      ],
      // 额外源码（sources）：与全部 @cplus_clang(){} 块体条目同批合并编译
      // 进 SLCpp.dll（同一 clang++ 命令多 TU 合并链接）——块内前置声明
      // 后即可调用其中函数；外部源的 SLCPP_EXPORT 导出同样进
      // SLCpp.dll.slffi 契约（FFI 直调，见 CPlusClangTest.sl 的
      // testExternalSource / s_ffiExtMul）。
      "sources": [ "COrCplusCode/SlCppExtraUtil.cpp" ],
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "disable",
      "capabilities": [
        { "type": "signLabel", "name": "signLabel" }
      ]
    },
    // masm_x64（蓝本 cplus_clang 同构第三实例，MASM x64 汇编域）：
    // lib 字符串直给（相对包路径，CVM 侧基准 = module.json 所在目录拼
    // sl_plugin_resolver_join_lib_path），从 plugin 原位加载。块体在
    // Front 导出期经插件 frontend（SLPF v3）生成 Entry_N.asm → ml64
    // 汇编 + trampoline C 编译合并链接 → SLMasm.dll 部署插件 dll 同目录
    //（package/windows/）；运行期 labelExec 装载 + GetProcAddress
    //（"<entry>_main"）固定原型调用（SLMasmValue = SLLabelValue 镜像）。
    // prefix 必须显式 = 实际符号前缀 "sl_masm_x64_"（plugin.jsonc
    // entry.prefix），缺省 id+"_" 会解析不到六件套符号。
    "masm_x64": {
      "name": "masm_x64_native_engine",
      "version": "0.1.0",
      "path": "plugin/masm_x64",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_masm_x64_",
      "lib": "../../../../plugin/masm_x64/package/windows/cvm_masm_x64.dll",
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "disable",
      "capabilities": [
        { "type": "signLabel", "name": "signLabel" }
      ]
    },
    // python_cpython：块体经 frontend（SLPF v3 契约）在 Front 导出期
    // 免编译部署为 <libDir>\pysrc\Entry_N.py（def run 源码，Python 解释
    // 型无需工具链）；labelExec 运行期经 py_bridge（LoadLibrary
    // python3xx.dll + Py_Initialize + sys.path 挂载 + import）执行。
    // 运行时依赖本机 CPython 3.10+（SL_PY_DLL 覆盖 / vendored dll 同目录
    // / PATH），无 CPython 时 enter 报 -102（onUnavailable=warn 不阻断，
    // 块运行期报错）。prefix = "sl_python_cpython_"（plugin.jsonc
    // entry.prefix）。块内 Boolean 放行（CPython 原生 bool 编组 INT 0|1）。
    "python_cpython": {
      "name": "python_runtime_use_cpython_engine",
      "version": "0.1.0",
      "path": "plugin/python_cpython",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_python_cpython_",
      "lib": "../../../../plugin/python_cpython/package/windows/cvm_python_cpython.dll",
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "signLabel", "name": "signLabel" }
      ]
    },
    // php_embed：块体经 frontend（SLPF v3 契约）在 Front 导出期免编译部署
    // 为 <libDir>\phpsrc\Entry_N.php（function run 源码，PHP 解释型无需工具
    // 链）；labelExec 运行期经 php_bridge（php_embed_init + 全局唯一函数
    // 重命名 sl_php_entry_<N>_v<K> + zend_eval_string + zend_call_function）
    // 执行。运行时依赖 vendored php8ts.dll（PHP 8.4 TS x64，与插件 dll 同
    // 目录，LoadLibraryEx ALTERED_SEARCH_PATH 自动命中）。prefix =
    // "sl_php_embed_"（plugin.jsonc entry.prefix）。块内 Boolean 放行
    //（PHP 原生 bool 编组 INT 0|1）；出通道表达式须加括号规避 Front
    //「不可以 $ 开头」铁律（见 PhpTest.sl）。
    "php_embed": {
      "name": "php_runtime_use_embed_sapi",
      "version": "0.1.0",
      "path": "plugin/php_embed",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_php_embed_",
      "lib": "../../../../plugin/php_embed/package/windows/cvm_php_embed.dll",
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "signLabel", "name": "signLabel" }
      ]
    },
    // typescript_nodev8：块体经 frontend（SLPF v3 契约）在 Front 导出期免编译
    // 部署为 <libDir>\scripts\Entry_N.mts（TS 原文，Node >= 22.6 原生类型
    // 擦除，零 tsc）；labelExec 运行期经 node_bridge（keep-alive node.exe
    // 子进程 + 行分隔 JSON stdio 协议 + host.mts 动态 import）执行。
    // 运行时依赖本机 node.exe（PATH / C:\Program Files\nodejs）。
    // prefix = "sl_typescript_nodev8_"（plugin.jsonc entry.prefix）。
    "typescript_nodev8": {
      "name": "typescript_runtime_use_nodejs_v8_engine",
      "version": "0.1.0",
      "path": "plugin/typescript_nodev8",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_typescript_nodev8_",
      "lib": "../../../../plugin/typescript_nodev8/package/windows/cvm_typescript_nodev8.dll",
      // 单文件引入（2026-11-27）：块头静态 import 经 parse 期提升到生成
      // 源码模块顶部；此处声明的源码按原始文件名部署 scripts\，块内以
      // './SlTsExtraUtil.mts' 相对 import 复用（Node 内置库 import 'node:*'
      // 与 npm 包 node_modules 上溯解析无需声明，Node 自行装载）。
      "sources": [ "TsCode/SlTsExtraUtil.mts" ],
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "signLabel", "name": "signLabel" }
      ]
    },
    // golang：块体经 frontend（SLPF v3 契约）在 Front 导出期生成 Entry_N.go
    //（package main + 预置 import + func Entry_N_run 形参标注 + _wrap 适配
    // 层），构建器组装临时目录（package\windows\gohost 驱动源 + 条目 +
    // 生成的 registry.go）后 `go build -trimpath`（CGO_ENABLED=0 /
    // GOTOOLCHAIN=local 覆盖注入，纯标准库离线）出自包含 SLGoHost.exe
    //（内嵌 Go 运行时）部署 <libDir>\go\——编译期产物，运行机器零 Go
    // 依赖；labelExec 运行期经 go_bridge（keep-alive SLGoHost.exe 子进程
    // + 行分隔 JSON stdio 协议 + registry 查表派发）执行。编译机依赖
    // go.exe（SLANG_GO_EXE / GOROOT / PATH / 官方安装位四级探测），缺失时
    // 块 build 报 kind=2 notFound。prefix = "sl_golang_"（plugin.jsonc entry.prefix）。
    // 块内 Boolean 放行（Go 原生 bool，规格 B）；出通道 Boolean 拒收
    //（bool 返回走缺省 int，python 先例口径）。
    "golang": {
      "name": "golang_runtime_use_host_go_toolchain",
      "version": "0.1.0",
      "path": "plugin/golang",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_golang_",
      "lib": "../../../../plugin/golang/package/windows/cvm_golang.dll",
      // 额外源码（sources，2026-11-28）：与全部 @golang(){} 块体条目同批
      // 合并编译进 SLGoHost.exe——构建器把外部 .go 文件按原文件名写进
      // 临时组装目录，Go 按目录整包收录 *.go：声明 package main 即与生成
      // 条目 Entry_N.go 同包直调（无需 import；Go 无相对路径 import，对照
      // java 域 SLAtSign 同包合并编译口径）；外部 .go 可自带 import 区
      //（逐文件解析），import 外部模块（首路径段含 '.'，如 github.com/xxx）
      // 时构建器 go build 追加 -mod=mod 自动解析依赖。见 GoTest.sl 的
      // testExternalSource / testBlockHeadImport。
      "sources": [ "GoCode/SlGoExtraUtil.go" ],
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "signLabel", "name": "signLabel" }
      ]
    }
  },
  // 插件系统方法（PLUGIN_SYSTEM_DESIGN.md §10.1）：cvmFunction = "plugin:<capability name>"，
  // 装配期 CVM 经 plugin registry 隐式 load+enter 插件 echo 后直注册 echo_exec
  //（sl_runtime_assembly_register_plugin_system_call）。
  // 注意：returnType/params 类型名须用 ResolveTypeName 支持的写法（float64 等，"double" 不识别）。
  "systemCalls": [
    { "name": "Echo", "returnType": "Float64", "params": ["Float64"], "isVariadic": false, "cvmFunction": "plugin:echo" },
    // @<tag>(){} 内联块哨兵（调用方工程须可见，Meta 层 SystemMethodCallDeclarationRegistry
    // 只装载当前工程 systemCalls；Core.jsonc 那份供 Core 模块自编译时使用）。
    // IRCall.TryParseAtSignLabelCall 拦截改写为 CallAtSignLabel(124)：首参 entryIndex
    // 常量不发射，CVM 经模块 atSignLabel[] 绑定 entryIndex 走插件 labelExec capability。
    { "name": "AtSignLabelCall",     "returnType": "Int32", "params": ["Int32"], "isVariadic": true,  "cvmFunction": "atsign:label" },
    { "name": "AtSignLabelCallVoid", "returnType": "Void",  "params": ["Int32"], "isVariadic": true,  "cvmFunction": "atsign:label" },
    // csharp_mono（P1-e）：SL 调 C# 静态方法——CSharpCallVoid/Int/String 三条声明已
    // 移到插件 refModule（CSharpMono 模块的 CSharpMono.jsonc systemCalls 段，带
    // "class": "SLang.Plugin.CSharpMono" 归属标记），经 plugins.csharp_mono 的
    // plugin.jsonc refModule 段在 RefModule 阶段自动加载，无需在此重复声明。
    // 栈协议不变（cvm_csharp_mono.c）：前 4 参 = asm/ns/class/method（String），
    // 第 5 参 = ret_kind（整型变参：0=void/1=int/2=string），其后为 C# 实参——
    // 变参按实际类型压栈不矫正（IRCall.cs ParseSystemCall 只矫正固定形参）。
    // 调用侧形如 SLang.Plugin.CSharpMono.CSharpCallInt(asm, ns, cls, m, 1, 40, 2)。
  ],
  "dllImports": [
    {
      "path": "../../../x64/Debug/CLangdll.dll", "name": "CLangdll", "alias": "CLangdll", "static": "CLangdll",
      "functions": [
        { "name": "libaddfunc", "symbol": "simplelanguage_addtest", "sig": "i32,i32->i32" }
      ]
    },
    { "path": "../../../x64/Debug/CLangdll.dll", "name": "CLangdll", "alias": "cl" },
    // SLCpp（cplus_clang 块构建产物）：块内 SLCPP_EXPORT 导出函数的 FFI
    // 直调绑定（@DllImport 第 1 实参别名查表，见 CPlusClangTest.sl）；
    // SLCpp.dll 与伴生契约 SLCpp.dll.slffi.json 由 Front 导出期构建段
    // 部署（path 与 plugins.cplus_clang.lib 同目录）。
    { "path": "../../../../plugin/cplus_clang/package/windows/SLCpp.dll", "name": "SLCpp", "alias": "SLCpp" }
  ],
  "references": [
    { "path": "./lib/Core.module.slb" },
    { "path": "./lib/Std.module.slb" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "SpecialTest",
    // 标准导出位 SlangAllInOne\out\export\SpecialTest\（common.ps1 TestMap
    // 与全部相对路径的解析基准：plugins 4 级上溯到仓库 plugin\ 树、
    // dllImports CLangdll 3 级上溯到 SlangAllInOne\x64\Debug——改成本地
    // "export" 会让运行期路径全部错位，勿动）
    "outputDir": "../../../out/export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  },
  "publish": {
    "mode": "both",
    "outputDir": "publish"
  }
}
