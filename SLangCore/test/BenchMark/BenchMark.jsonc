{
  "project":
  {
    "name": "BenchMark",
    "desc": "BenchMark project - internal performance test cases (HelloWorld / Fibonacci / Loop / Levenshtein / DataTypes / StringBench / RegExpBench / NQueens / Sieve / QuickSort / MatrixMul / BinaryTree / Mandelbrot)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": true,
    "target": "x64",
    "debug": false,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "HelloWorld.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "EqBench.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "Fibonacci.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "Loop.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "Levenshtein.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "DataTypes.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "StringBench.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "RegExpBench.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "NQueens.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "Sieve.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "QuickSort.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "MatrixMul.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "BinaryTree.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "Mandelbrot.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "CSharpBench.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 },
      { "path": "JavaBench.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std"
    ],
    "replace": {
      "DEBUG": "true"
    },
    "data": {
      "var1": 12,
      "arrvar1": [1, 2, 3, 4, 5],
      "vardata2": {
        "a": 10,
        "b": 20.1
      }
    }
  },
  // 插件声明（同 SpecialTest/ProjectTest.jsonc 口径）：csharp_mono / java_hotspot
  // 均用字符串 lib 原位加载（不走 PluginManager 拷贝），相对路径按本 jsonc 所在
  // 目录解析（上溯 4 级 = D:\project\lang\plugin）。
  "plugins": {
    "csharp_mono": {
      "name": "csharp_runtime_use_mono_engine",
      "version": "0.1.0",
      "path": "plugin/csharp_mono",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_csharp_mono_",
      "lib": "../../../../plugin/csharp_mono/package/windows/cvm_csharp_mono.dll",
      "sources": [ "CsExtra/SlBenchLib.cs" ],
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "systemCall", "name": "csharp" }
      ]
    },
    "java_hotspot": {
      "name": "java_runtime_use_hotspot_engine",
      "version": "0.1.0",
      "path": "plugin/java_hotspot",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_java_hotspot_",
      "lib": "../../../../plugin/java_hotspot/package/windows/cvm_java_hotspot.dll",
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "signLabel", "name": "signLabel" }
      ]
    }
  },
  // @<tag>(){} 内联块哨兵（调用方工程须在自身 systemCalls 声明，Meta 层
  // SystemMethodCallDeclarationRegistry 只装载当前工程 systemCalls）。
  // CSharpCall 系列经 csharp_mono 插件 refModule 自动加载，无需在此声明。
  "systemCalls": [
    { "name": "AtSignLabelCall",     "returnType": "Int32", "params": ["Int32"], "isVariadic": true,  "cvmFunction": "atsign:label" },
    { "name": "AtSignLabelCallVoid", "returnType": "Void",  "params": ["Int32"], "isVariadic": true,  "cvmFunction": "atsign:label" }
  ],
  "references": [
    { "path": "./lib/Core.module.slb" },
    { "path": "./lib/Std.module.slb" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "BenchMark",
    "outputDir": "..\\..\\..\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  },
  "publish": {
    "mode": "both",
    "outputDir": "publish",
    "config": "Release"
  }
}
