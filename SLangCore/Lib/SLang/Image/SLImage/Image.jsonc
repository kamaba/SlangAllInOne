{
  "project":
  {
    "name": "SLangImage",
    "desc": "CPU image decode/encode library module - namespace Image: ImageFfi (FFI static bindings + memory marshalling) / ImageIO (facade load/save/probe/convert/show) / ImageBuffer (tight pixel buffer, pure-SL pixel ops incl Pillow-Image-style newImage/paste/pasteMasked/rotate/splitChannels/mergeRgba/mergeRgb/alphaComposite/blend) / ImageInfo (header probe) / Gif (animated GIF split into ImageBuffer frames and frame-by-frame GIF composition: GifDocument/GifEncoder/Gif facade) / ImageSequence (Pillow-style multi-frame sequence iteration: ImageSequenceIterator with seek/tell/nFrames for-in support + allFrames/allImages/framesOfImage/saveFrame/saveAllFrames facade) / ImageFilter (Pillow-ImageFilter-style named 3x3 convolution filters: Blur/Contour/Emboss/FindEdges/Sharpen/Smooth + convolve3x3 generic kernel) / ImageChops (Pillow-ImageChops channel ops: add/subtract/multiply/screen/difference/lighter/darker/invert + softLight/hardLight/overlay blend modes) / ImageEnhance (Pillow-ImageEnhance brightness/contrast/color/sharpness + grayscale) / ImageMask (gradient/circular/pattern/checkerboard mask generation + applyMaskBlend/transitionBlend/checkerboardBlend) / ImageDraw (Pillow-ImageDraw point/line/rectangle/ellipse/polygon/arc/circle + 3x5 bitmap text), pixel color class ColorInt now lives in Std root (Std/ColorInt.sl), backed by sl_image_lib.dll (stb_image/stb_image_write public-domain OR MIT-0 + WIC system codec + self-written GIF89a encoder; always RGBA8 top-down, handles are 1-based, 0 = invalid)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  // FFI 导入表（jsonc "dllImports" 段）。"static" 非空（静态注册名）时 cvm 加载
  // SL 模块即预载该库并注册进 FFI.StaticLibrary，@DllStaticImport("sl_image_lib",
  // "sli_xxx") 静态调用点由 cvm 装配期 attribute 注册表改写为 CallFFIStatic(n)
  // 直调绑定表。绑定失败（库未注册 / 符号缺失）时回退 SL 函数体兜底（返回
  // false/0/""，ImageFfi.ensureReady() == false 即兜底征兆）。"alias" 仍供
  // @DllImport 三参形式按别名解析 path（运行时相对进程 CWD 解析）。
  "dllImports":
  [
    { "path": "sl_image_lib.dll", "name": "sl_image_lib", "alias": "sl_image_lib", "static": "sl_image_lib" }
  ],
  // vmDlls 构建规则：导出 SL 模块时，Front 用 MSBuild 编译 project 指向的 VS 工程
  // （路径相对本 jsonc 所在目录），并把产出的 sl_image_lib.dll 拷贝到与
  // SLangImage.module.json 相同的目录（out/export/SLangImage/），即上方
  // dllImports 别名指向的位置。
  // C 实现位于 SlangAllInOne\SLangCore\Lib\SLang\Image\cvm_image_lib\：
  //   vm_sl_image.h     - 公开契约（55 个 sli_* 导出：22 静图 + 13 GIF 动画 +
  //                       20 sli_op_* 像素批量运算【卷积/旋转/缩放/合成混合/
  //                       通道拆合/格式转换/贴入/填充/翻转/预乘 + 高级合成：
  //                       灰度/通道运算11模式/蒙版混合/带蒙版贴入/外插混合，
  //                       重循环下沉 C 层，SL 侧失败回落纯 SL 循环兜底】，
  //                       普通 C ABI）
  //   sl_image.c        - 槽表/粘性错误/格式嗅探/解码编码主路
  //   Codec\sl_image_stb.c  - stb_image v2.31 + stb_image_write v1.17 唯一
  //                           IMPLEMENTATION 编译点（third_party\stb\，公有领域
  //                           OR MIT-0 双许可）
  //   Codec\sl_image_wic.c  - WIC 兜底（TIFF/ICO/WebP 解码 + TIFF 编码，纯 C
  //                           lpVtbl 调用，系统组件零外部依赖）
  // 像素契约：恒 RGBA8、4 字节/像素、top-down；图像/blob 句柄 1 起始，0 无效。
  // 上限：16384×16384 / 256M 像素 / 单文件 512MB（详见 vm_sl_image.h）。
  "vmDlls": [
    { "project": "../cvm_image_lib/cvm_sl_image_lib.vcxproj", "name": "sl_image_lib.dll", "configuration": "Release", "platform": "x64" }
  ],
  // systemCalls：本模块全部能力走 @DllStaticImport 静态绑定直调，不下沉 cvm
  // SystemMethodCall，故留空。
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "ImageFormat.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 0 },
      // Color.sl 已删除：8bit 颜色类合并为 Std 根级 ColorInt（Std/ColorInt.sl），
      // 经下方 references 的 Std 引用，ImageBuffer/Svg/Png 裸名使用。
      { "path": "ImageBuffer.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 2 },
      { "path": "ImageInfo.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 3 },
      { "path": "ImageFfi.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 4 },
      { "path": "ImageIO.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 5 },
      { "path": "Png.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 6 },
      { "path": "Jpeg.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 7 },
      { "path": "Webp.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 8 },
      { "path": "Svg.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 9 },
      // Gif.sl：GIF 动画拆解/合成（GifDocument/GifEncoder/Gif 门面，
      // 自持 13 个 sli_gif_* 绑定，只向后引用 ImageFfi/ImageBuffer）
      { "path": "Gif.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 10 },
      // ImageSequence.sl：多帧序列遍历门面（仿 Pillow ImageSequence：
      // Iterator/allFrames/seek/tell/nFrames + 帧落盘，纯 SL 组合 Gif/ImageIO）
      { "path": "ImageSequence.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 11 },
      // ImageFilter.sl：3x3 卷积滤镜（仿 Pillow ImageFilter：Blur/Contour/
      // Emboss/FindEdges/Sharpen/Smooth 等 8 命名滤镜 + convolve3x3 通用核）
      { "path": "ImageFilter.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 12 },
      // ImageChops.sl：通道运算（仿 Pillow ImageChops：add/subtract/multiply/
      // screen/difference/lighter/darker/invert + softLight/hardLight/overlay）
      { "path": "ImageChops.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 13 },
      // ImageEnhance.sl：图像增强（仿 Pillow ImageEnhance：brightness/contrast/
      // color/sharpness + grayscale）
      { "path": "ImageEnhance.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 14 },
      // ImageMask.sl：蒙版生成与蒙版合成（仿 Pillow advanced：渐变/圆形/
      // 图案/棋盘蒙版 + applyMaskBlend/transitionBlend/checkerboardBlend）
      { "path": "ImageMask.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 15 },
      // ImageDraw.sl：2D 绘图（仿 Pillow ImageDraw：point/line/rectangle/
      // ellipse/polygon/arc/circle + text 3x5 位图字体）
      { "path": "ImageDraw.sl", "group": "image", "tag": "codec", "ignore": false, "priority": 16 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "references": [
    // SystemConvertInt32/UInt8、Memory.alloc/free/writeI8/readUInt8/readInt32
    // 等来自 Core（本 jsonc 位于 SLangCore\Lib\SLang\Image\SLImage\，上 3 级到
    // SLangCore\Lib\，同层即 Core 包）。本模块不依赖 Math。
    { "path": "../../../Core", "name": "Core" },
    // ColorInt（8bit RGBA 颜色，原本模块 Image.Color + Render 侧 ColorUInt8
    // 合并迁入 Std 根级）：ImageBuffer/Svg/Png 裸名引用。
    { "path": "../../../Std", "name": "Std" }
  ],
  // struct 段：namespace Image 下全部顶级类型（ImageFormat.sl 的警告——所有
  // 类型必须是 namespace 下的顶级类型，嵌套类型会让导出端把父类全名写进
  // namespaceList，加载端随即创建同名命名空间节点遮蔽类节点）。
  "struct": [
    { "namespace": "Image", "children": [
      { "enum": "EImageFormat" },
      { "enum": "EPixelFormat" },
      { "enum": "EColorSpace" },
      { "enum": "EInterpolation" },
      { "enum": "EOrientation" },
      { "enum": "ImageErrorCode" },
      // Color 类已迁出：合并为 Std 根级 ColorInt（struct 不再登记）
      { "class": "ImageBuffer" },
      { "class": "ImageInfo" },
      { "class": "ImageFfi" },
      { "class": "ImageIO" },
      { "enum": "EPngColorType" },
      { "enum": "EPngInterlace" },
      { "class": "PngChunk" },
      { "class": "PngHeader" },
      { "class": "PngEncodeOptions" },
      { "class": "PngDecodeOptions" },
      { "class": "Png" },
      { "enum": "EMpegVersion" },
      { "enum": "EMpegLayer" },
      { "enum": "EMpegChannelMode" },
      { "enum": "EChromaSubsampling" },
      { "enum": "EJpegMode" },
      { "class": "JpegFrameHeader" },
      { "class": "JpegExif" },
      { "class": "JpegEncodeOptions" },
      { "class": "JpegDecodeOptions" },
      { "class": "Jpeg" },
      { "enum": "EWebpFormat" },
      { "enum": "EWebpPreset" },
      { "class": "WebpEncodeOptions" },
      { "class": "WebpFrameInfo" },
      { "class": "WebpDecodeOptions" },
      { "class": "Webp" },
      { "class": "SvgViewBox" },
      { "class": "SvgPathCursor" },
      { "class": "SvgPathCommand" },
      { "class": "SvgPath" },
      { "class": "SvgElement" },
      { "class": "SvgRect" },
      { "class": "SvgCircle" },
      { "class": "SvgEllipse" },
      { "class": "SvgLine" },
      { "class": "SvgPolygon" },
      { "class": "SvgText" },
      { "class": "SvgPathElement" },
      { "class": "SvgGroup" },
      { "class": "SvgDocument" },
      { "class": "Svg" },
      { "class": "GifFrame" },
      { "class": "GifDocument" },
      { "class": "Gif" },
      { "class": "GifEncoder" },
      // ImageSequence（仿 Pillow ImageSequence 模块）：帧游标实现
      // Core.IIterable/IIterator<GifFrame> 可 for-in；门面全静态
      { "class": "ImageSequenceIterator" },
      { "class": "ImageSequence" },
      // ImageFilter（仿 Pillow ImageFilter 模块）：命名滤镜 + 通用 3x3 卷积
      { "enum": "EImageFilter" },
      { "class": "ImageFilter" },
      // ImageChops（仿 Pillow ImageChops）：8 通道运算 + 3 混合模式
      { "class": "ImageChops" },
      // ImageEnhance（仿 Pillow ImageEnhance）：四增强器 + grayscale
      { "class": "ImageEnhance" },
      // ImageMask（仿 Pillow advanced 蒙版）：蒙版生成 + 蒙版合成
      { "enum": "EMaskDirection" },
      { "enum": "EMaskPattern" },
      { "class": "ImageMask" },
      // ImageDraw（仿 Pillow ImageDraw）：几何绘制 + 3x5 位图文本
      { "class": "ImageDraw" }
    ]}
  ],
  "export": {
    "moduleName": "SLangImage",
    // 纯模块（类似 DLL，2026-11-27）：publish 恒不产可执行文件（mode exe/both
    // 自动降级 slb），仅导出 .slb 模块包供消费方 references 引用（publish-guide.md §2.1）。
    "executable": false,
    // jsonc 位于 SLangCore\Lib\SLang\Image\SLImage\，上 5 级到
    // SlangAllInOne\out\export（ImageTest 引用 ../../../../out/export/SLangImage）
    "outputDir": "..\\..\\..\\..\\..\\out\\export",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true,
    // Front 调试文本实际目录：{export.outputDir}/{export.moduleName}/DebugCode/；以下 outputDir 仅兼容旧字段，可为空。
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
