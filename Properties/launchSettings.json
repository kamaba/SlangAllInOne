{
  "profiles": {
    // F5 mixed-mode debugging: C# breakpoints in Frontend sources
    // (SimpleLanguageFront) + native breakpoints in C VM sources
    // (csimple_lang/src/**) in the same process. The dev-mode run loads
    // the C VM from csimple_lang\build\Debug\bin (with its .pdb).
    // Absolute paths on purpose: dotnet run does not honor the profile
    // workingDirectory, so relative project paths break under some shells.
    // 🔥 2026-10-22 CLI 语义：裸工程路径 = 编译+运行一体化（原 `slang run <工程>`）。
    "MiniSmoke (C# + C VM mixed)": {
      "commandName": "Project",
      "commandLineArgs": "D:\\project\\lang\\SlangAllInOne\\SLangCore\\test\\Other\\MiniSmoke\\MiniSmoke",
      "nativeDebugging": true
    },
    "run ProjectTest module (C# + C VM mixed)": {
      "commandName": "Project",
      "commandLineArgs": "run D:\\project\\lang\\SlangAllInOne\\out\\export\\ProjectTest\\ProjectTest.module.json",
      "nativeDebugging": true
    },
    "package": {
      "commandName": "Project",
      "commandLineArgs": "",
      "nativeDebugging": true
    }
  }
}
