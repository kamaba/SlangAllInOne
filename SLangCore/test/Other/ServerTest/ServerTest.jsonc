{
  "project":
  {
    "name": "ServerTest",
    "desc": "SLangServer acceptance test project - P0 probes/engine + P1/P1.5/P2/P3/P4/P4.5 (SERVER_DESIGN.md section 8)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "ServerProbeTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerCoreTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP1Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP15Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP2Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP3Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP4Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP45Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP5Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP6Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP7Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP9Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerP10Test.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerMultiListenTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerMysqlTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ServerBench.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console",
      "Std.IO.File",
      "Std.IO.FileStream"
    ],
    "replace": {
      "DEBUG": "true"
    },
    // MySQL 连接目标（run 时用 global.<name> 读取，ServerMysqlTest 用，见 ServerTest.md）。
    // ⚠️ 这里是真实环境的账号密码，仅限本机开发测试使用，请勿提交到公共仓库；
    //    正式迁移请改为环境变量 / 本地未纳入版本管理的配置文件。
    "data": {
      "mysqlHost": "bj-cdb-mri5uaiu.sql.tencentcdb.com",
      "mysqlPort": 22718,
      "mysqlUser": "root",
      "mysqlPassword": "Likecg00@123",
      "mysqlDatabase": "ry_net",
      "mysqlTestDb": "sl_mysql_test",
      "mysqlCharset": "utf8mb4"
    }
  },
  "references": [
    { "path": "./lib/Core.module.slb" },
    { "path": "./lib/Std.module.slb" },
    { "path": "../../../../out/export/SLangServer/SLangServer.module.json" },
    { "path": "../../../../out/export/SLangMysql/SLangMysql.module.json" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "ServerTest",
    "outputDir": "..\\..\\..\\..\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  },
  "publish": {
    "mode": "both",
    "outputDir": "publish"
  }
}
