{
  // slQT 模块编译清单（模块名 SLangQT；标准库形态模块，Lib\SLang\QT\ 根布局——
  // 与 Mysql/Server/Render/WebUI 同构：*.sp/*.jsonc/*.sl 在模块根，原生层在 cvm\。
  // 2026-11-02 去插件化 + 布局对齐：无 plugin.jsonc，引用方 references 显式引用
  // 本模块 out\export 产物（ServerTest/MysqlTest 同款直引形态））。
  // 对照 SLang/WebUI/WebUI.jsonc（FFI 原生绑定 + vmDlls 自动构建原生 DLL）。
  // 构建：cvm/build-slqt.ps1（或直接 dotnet run --project
  // simple_language/source/SimpleLanguageFront.csproj -- compile -p SlangAllInOne/SLangCore/Lib/SLang/QT/QT.sp -e ir）
  "project": {
    "name": "SLangQT",
    "desc": "SLang binds Qt6 Widgets (PyQt-like GUI library, backed by slang_qt.dll)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "dllImports": [
    {
      "path": "slang_qt.dll",
      "name": "slang_qt",
      "alias": "slang_qt",
      "static": "slang_qt"
    }
  ],
  // 模块构建时顺带编译原生 DLL（Front 按 name 拷贝产物到导出目录，便于运行期装载）。
  // 默认 STUB 版（纯 C，无需 Qt，可 headless 验证 SL 链路）；真实 Qt 渲染替换为 slang_qt_qt.vcxproj。
  "vmDlls": [
    {
      "project": "cvm/slang_qt.vcxproj",
      "name": "slang_qt.dll",
      "configuration": "Release",
      "platform": "x64"
    }
  ],
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "QTFFI.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QObject.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QWidget.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QPushButton.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QLabel.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QLineEdit.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QTextEdit.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QListWidget.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QMainWindow.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QApplication.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QTimer.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      // 2026-11-10 VS 式主框架扩展（菜单/工具栏/Dock/MDI/对话框）
      { "path": "core/QMenuBar.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QMenu.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QAction.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QToolBar.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QDockWidget.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QMdiArea.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "core/QDialog.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "layout/QLayout.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "layout/QVBoxLayout.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "layout/QHBoxLayout.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      { "path": "layout/QGridLayout.sl", "group": "qt", "tag": "gui", "ignore": false, "priority": 0 },
      // 2026-11-03 扩展面（qtRuntime 组合部署配套；tag=ext 便于按需裁剪）
      { "path": "net/Net.sl", "group": "qt", "tag": "ext", "ignore": false, "priority": 0 },
      { "path": "sql/Sql.sl", "group": "qt", "tag": "ext", "ignore": false, "priority": 0 },
      { "path": "svg/Svg.sl", "group": "qt", "tag": "ext", "ignore": false, "priority": 0 },
      { "path": "gl/GL.sl", "group": "qt", "tag": "ext", "ignore": false, "priority": 0 },
      { "path": "print/Print.sl", "group": "qt", "tag": "ext", "ignore": false, "priority": 0 },
      { "path": "xml/Xml.sl", "group": "qt", "tag": "ext", "ignore": false, "priority": 0 },
      { "path": "concurrent/Concurrent.sl", "group": "qt", "tag": "ext", "ignore": false, "priority": 0 },
      { "path": "uitools/UiTools.sl", "group": "qt", "tag": "ext", "ignore": false, "priority": 0 },
      { "path": "help/Help.sl", "group": "qt", "tag": "ext", "ignore": false, "priority": 0 },
      { "path": "dbus/DBus.sl", "group": "qt", "tag": "ext", "ignore": false, "priority": 0 }
    ]
  },
  "references": [
    // 本 jsonc 位于 SLangCore\Lib\SLang\QT\，上 2 级到 SLangCore\Lib\（同层 Core/Std 包；
    // Mysql/WebUI 同款两级引用形态）
    { "path": "../../Core", "name": "Core" },
    { "path": "../../Std", "name": "Std" }
  ],
  "struct": [
    {
      "namespace": "SLang",
      "children": [
        { "class": "QT" },
        { "class": "QObject" },
        { "class": "QWidget" },
        { "class": "QPushButton" },
        { "class": "QLabel" },
        { "class": "QLineEdit" },
        { "class": "QTextEdit" },
        { "class": "QListWidget" },
        { "class": "QMainWindow" },
        { "class": "QApplication" },
        { "class": "QTimer" },
        { "class": "QMenuBar" },
        { "class": "QMenu" },
        { "class": "QAction" },
        { "class": "QToolBar" },
        { "class": "QDockWidget" },
        { "class": "QMdiArea" },
        { "class": "QMdiSubWindow" },
        { "class": "QDialog" },
        { "class": "QLayout" },
        { "class": "QVBoxLayout" },
        { "class": "QHBoxLayout" },
        { "class": "QGridLayout" },
        { "class": "QNetworkAccessManager" },
        { "class": "QNetworkReply" },
        { "class": "QSqlDatabase" },
        { "class": "QSqlQuery" },
        { "class": "QSvgWidget" },
        { "class": "QSvgRenderer" },
        { "class": "QGLPanel" },
        { "class": "QPrinter" },
        { "class": "QDomDocument" },
        { "class": "QConcurrentTask" },
        { "class": "QLoadedWidget" },
        { "class": "QUiLoader" },
        { "class": "QFormBuilder" },
        { "class": "QHelpEngine" },
        { "class": "QDBus" }
      ]
    }
  ],
  "export": {
    "moduleName": "SLangQT",
    "outputDir": "..\\..\\..\\..\\out\\export",
    "versionMain": 0,
    "versionSub": 1,
    "versionPatch": 0,
    "includeMetadata": true,
    // Front 调试文本实际目录：{export.outputDir}/{export.moduleName}/DebugCode/；以下 outputDir 仅兼容旧字段，可为空。
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  },
  "global": {
    "imports": []
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  }
}
