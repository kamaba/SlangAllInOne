{
  "project":
  {
    "name": "SLangAudio",
    "desc": "CPU audio decode/stream/playback library module - namespace Audio: AudioFfi (FFI static bindings + memory marshalling) / AudioIO (facade probe/load/stream/play) / AudioClip (whole-decode preloaded clip, instant-play ready) / AudioStream (feed-compressed-pull-PCM streaming) / AudioPlayer (waveOut playback) / AudioBuffer (Float32 interleaved PCM buffer, pure-SL ops) / AudioInfo (probe) / Wav+Mp3 (pure-SL header parsers), backed by sl_audio_lib.dll (minimp4 + minimp3 CC0 public-domain; Media Foundation AAC decoder MFT; waveOut playback with internal service thread + ring buffer, no ffmpeg, all streaming implemented in-repo; output is always interleaved S16LE, handles are 1-based, 0 = invalid)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  // FFI 导入表（同 Image.jsonc 约定）。"static" 非空（静态注册名）时 cvm
  // 加载 SL 模块即预载 sl_audio_lib.dll 并注册进 FFI.StaticLibrary，
  // @DllStaticImport("sl_audio_lib", "sla_xxx") 静态调用点由 cvm 装配期
  // attribute 注册表改写为 CallFFIStatic(n) 直调绑定表。绑定失败（库未
  // 注册 / 符号缺失）时回退 SL 函数体兜底（返回 false/0/""，
  // AudioFfi.ensureReady() == false 即兜底征兆，AudioIO 各入口随即走
  // 纯 SL WAV 回退路径）。
  "dllImports":
  [
    { "path": "sl_audio_lib.dll", "name": "sl_audio_lib", "alias": "sl_audio_lib", "static": "sl_audio_lib" }
  ],
  // vmDlls 构建规则：导出 SL 模块时，Front 用 MSBuild 编译 project 指向
  // 的 VS 工程（路径相对本 jsonc 所在目录），并把产出的 sl_audio_lib.dll
  // 拷贝到与 SLangAudio.module.json 相同的目录（out/export/SLangAudio/），
  // 即上方 dllImports 别名指向的位置。
  // C 实现位于 SlangAllInOne\SLangCore\Lib\SLang\Audio\cvm_audio_lib\：
  //   vm_sl_audio.h      - 公开契约（34 个 sla_* 导出，普通 C ABI，
  //                         PCM 恒 interleaved S16LE）
  //   sl_audio.c         - 槽表/粘性错误/格式嗅探/解码流式播放主调度
  //   Codec\sl_audio_wav.c   - RIFF/PCM 解析 + 裸 PCM 位深转换（纯 C）
  //   Codec\sl_audio_mp3.c   - minimp3 唯一 IMPLEMENTATION 编译点
  //                            （third_party\minimp3\，CC0 公有领域）
  //   Codec\sl_audio_mp4.c   - minimp4 唯一 IMPLEMENTATION 编译点
  //                            （third_party\minimp4\，CC0 公有领域）：
  //                            MP4 音轨解封装（sowt/lpcm 直读、MP3 帧
  //                            喂 minimp3、AAC 喂 MF MFT）
  //   Codec\sl_audio_mf.c    - Media Foundation AAC 解码 MFT（系统组件
  //                            mfplat + wmcodecdspuuid，纯 C lpVtbl，
  //                            与 Image 模块 WIC 兜底同款先例）
  //   Codec\sl_audio_wave.c  - waveOut 播放（系统 winmm，内部服务线程
  //                            + 字节环形缓冲 + 4 WAVEHDR 轮转）
  // 禁 ffmpeg：MP4/MP3 解析走内置 CC0 单头库，AAC 走系统 MFT，流数据
  // 全部内部源码实现（无外部进程 / 无外部解码器依赖）。
  // 上限：768kHz / 8ch / 2^28 帧；槽位 32 dec / 16 stream / 8 player。
  "vmDlls": [
    { "project": "cvm_audio_lib/cvm_sl_audio_lib.vcxproj", "name": "sl_audio_lib.dll", "configuration": "Release", "platform": "x64" }
  ],
  // systemCalls：本模块全部能力走 @DllStaticImport 静态绑定直调，不下沉
  // cvm SystemMethodCall，故留空。
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "AudioFormat.sl", "group": "audio", "tag": "codec", "ignore": false, "priority": 0 },
      { "path": "Wav.sl", "group": "audio", "tag": "codec", "ignore": false, "priority": 1 },
      { "path": "AudioBuffer.sl", "group": "audio", "tag": "codec", "ignore": false, "priority": 2 },
      { "path": "AudioInfo.sl", "group": "audio", "tag": "codec", "ignore": false, "priority": 3 },
      { "path": "Mp3.sl", "group": "audio", "tag": "codec", "ignore": false, "priority": 4 },
      { "path": "AudioFfi.sl", "group": "audio", "tag": "ffi", "ignore": false, "priority": 5 },
      { "path": "AudioClip.sl", "group": "audio", "tag": "runtime", "ignore": false, "priority": 6 },
      { "path": "AudioStream.sl", "group": "audio", "tag": "runtime", "ignore": false, "priority": 7 },
      { "path": "AudioPlayer.sl", "group": "audio", "tag": "runtime", "ignore": false, "priority": 8 },
      { "path": "AudioSource.sl", "group": "audio", "tag": "runtime", "ignore": false, "priority": 9 },
      { "path": "AudioIO.sl", "group": "audio", "tag": "facade", "ignore": false, "priority": 10 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "references": [
    // Memory.alloc/free/writeI8/readUInt8/readInt16/readInt32、
    // SystemConvertInt32/UInt8、SystemTimerNowMillis 等来自 Core。
    // 本 jsonc 位于 SLangCore\Lib\SLang\Audio\，上 2 级到 SLangCore\Lib\，
    // 同层即 Core 包。
    { "path": "../../Core", "name": "Core" }
  ],
  // struct 段：namespace Audio 下全部顶级类型（不嵌套，嵌套类型会让
  // 导出端把父类全名写进 namespaceList 造成节点遮蔽——见 Image.jsonc
  // 的同款注释）。
  "struct": [
    { "namespace": "Audio", "children": [
      { "enum": "EAudioFormat" },
      { "enum": "ESampleFormat" },
      { "enum": "EChannelLayout" },
      { "enum": "ESampleRate" },
      { "enum": "EBitrateMode" },
      { "enum": "AudioErrorCode" },
      { "class": "AudioFormatInfo" },
      { "enum": "EWaveFormatTag" },
      { "class": "WavHeader" },
      { "class": "Wav" },
      { "class": "AudioBuffer" },
      { "class": "AudioInfo" },
      { "enum": "EMp3Version" },
      { "enum": "EMp3Layer" },
      { "enum": "EMp3ChannelMode" },
      { "class": "Mp3FrameHeader" },
      { "class": "ID3Frame" },
      { "class": "ID3v2Tag" },
      { "class": "Mp3EncodeOptions" },
      { "class": "Mp3" },
      { "class": "AudioFfi" },
      { "class": "AudioClip" },
      { "class": "AudioStream" },
      { "class": "AudioPlayer" },
      { "class": "AudioSource" },
      { "class": "AudioIO" }
    ]}
  ],
  "export": {
    "moduleName": "SLangAudio",
    // jsonc 位于 SLangCore\Lib\SLang\Audio\，上 4 级到
    // SlangAllInOne\out\export（RenderTest 引用 ../../../../out/export/SLangAudio）
    "outputDir": "..\\..\\..\\..\\out\\export",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true,
    // Front 调试文本实际目录：{export.outputDir}/{export.moduleName}/DebugCode/；以下 outputDir 仅兼容旧字段，可为空。
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
